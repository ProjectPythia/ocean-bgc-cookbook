","label":"Bring in POP grid utilities","html_id":"bring-in-pop-grid-utilities","implicit":true,"key":"wGPPDGlv7f"}],"key":"rYmEN9g5nn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds_grid = pop_tools.get_grid('POP_gx1v7')\nlons = ds_grid.TLONG\nlats = ds_grid.TLAT\ndepths = ds_grid.z_t * 0.01","key":"tXRbU1AGMP"},{"type":"outputs","id":"mzK6gi_NtH2VFATPoBWc4","children":[],"key":"xeZT9UKmM8"}],"key":"CUMvUznJ2m"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds_grid","key":"vVCP5RwvOP"},{"type":"outputs","id":"hCDdjBoZlHN1IkRw3AbI7","children":[],"key":"wqtuqDi6nb"}],"key":"oNAIwucJWE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Load the data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gQD0buGcDC"}],"identifier":"load-the-data","label":"Load the data","html_id":"load-the-data","implicit":true,"key":"oT22x2qeN6"}],"key":"SlG7OZzBG6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"jetstream_url = 'https://js2.jetstream-cloud.org:8001/'\n\ns3 = s3fs.S3FileSystem(anon=True, client_kwargs=dict(endpoint_url=jetstream_url))\n\n# Generate a list of all files in CESM folder\ns3path = 's3://pythia/ocean-bgc/cesm/g.e22.GOMIPECOIAF_JRA-1p4-2018.TL319_g17.4p2z.002branch/ocn/proc/tseries/month_1/*'\nremote_files = s3.glob(s3path)\ns3.invalidate_cache()\n# Open all files from folder\nfileset = [s3.open(file) for file in remote_files]\n\n# Open with xarray\nds = xr.open_mfdataset(fileset, data_vars=\"minimal\", coords='minimal', compat=\"override\", parallel=True,\n                       drop_variables=[\"transport_components\", \"transport_regions\", 'moc_components'], decode_times=True)\n\nds","key":"keX6exaefI"},{"type":"outputs","id":"mb7lBPlXPmIgZptmA6E95","children":[],"key":"CvRQhs5Z25"}],"key":"V2Qm9S909K"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Subsetting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FUJCS27ifk"}],"identifier":"subsetting","label":"Subsetting","html_id":"subsetting","implicit":true,"key":"RzuWgM00ix"}],"key":"vIynoxHC4k"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"variables =['FG_CO2','photoC_TOT_zint','POC_FLUX_100m']\nkeep_vars=['z_t','z_t_150m','dz','time_bound', 'time', 'TAREA','TLAT','TLONG'] + variables\nds = ds.drop_vars([v for v in ds.variables if v not in keep_vars])","key":"NODvTw2kt3"},{"type":"outputs","id":"ZQdTHwjnlrWnEHW6wM4pf","children":[],"key":"Gdju7I9dqA"}],"key":"HcDk0GhkXC"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Processing - means in time and space","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Tf5nwZnjlR"}],"identifier":"processing-means-in-time-and-space","label":"Processing - means in time and space","html_id":"processing-means-in-time-and-space","implicit":true,"key":"BOQ8BDHKKo"}],"key":"vJSagZ1UwI"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pull in the function we defined in the nutrients notebook...","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"uNcJFvAvqg"}],"key":"MXxVJFiGZy"}],"key":"yvH94ee3Lg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Properly convert monthly data to annual means, taking into account month lengths.\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the year for each season is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")","key":"sOiqXsPhYZ"},{"type":"outputs","id":"8lcmR93-Xa8qVna48eHOK","children":[],"key":"JhcAX01SLP"}],"key":"fg09XQwF9U"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We also define a new function to take global mean in space.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FdnlwFF8S0"}],"key":"eyo4MsWecO"}],"key":"g26CuYVUB5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def global_mean(ds, ds_grid, compute_vars, normalize=True, include_ms=False):\n    \"\"\"\n    Compute the global mean on a POP dataset. \n    Return computed quantity in conventional units.\n    \"\"\"\n\n    other_vars = list(set(ds.variables) - set(compute_vars))\n\n    # note TAREA is in cm^2, which affects units\n    \n    if include_ms: # marginal seas!\n        surface_mask = ds_grid.TAREA.where(ds_grid.KMT > 0).fillna(0.)\n    else:\n        surface_mask = ds_grid.TAREA.where(ds_grid.REGION_MASK > 0).fillna(0.)        \n    \n    masked_area = {\n        v: surface_mask.where(ds[v].notnull()).fillna(0.) \n        for v in compute_vars\n    }\n    \n    with xr.set_options(keep_attrs=True):\n        \n        dso = xr.Dataset({\n            v: (ds[v] * masked_area[v]).sum(['nlat', 'nlon'])\n            for v in compute_vars\n        })\n        \n        if normalize:\n            dso = xr.Dataset({\n                v: dso[v] / masked_area[v].sum(['nlat', 'nlon'])\n                for v in compute_vars\n            })            \n                \n    return dso","key":"FuGP7VmN09"},{"type":"outputs","id":"ipmtNZ6Hftx6FzX3h2uLm","children":[],"key":"inQLSnh8rm"}],"key":"LlDrkpsbeC"},{"type":"block","kind":"notebook-content","data":{"jp-MarkdownHeadingCollapsed":true},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Take the long-term mean of our data set. We process monthly to annual with our custom function, then use xarray’s built-in ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pfbj6dMPTY"},{"type":"inlineCode","value":".mean()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Q87sR5c7uy"},{"type":"text","value":" function to process from annual data to a single mean over time, since each year is the same length.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Z78bAO3MGB"}],"key":"MwcaoMK6XV"}],"key":"ficpDjk51q"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds = year_mean(ds).mean(\"year\")","key":"APMEDLBnZl"},{"type":"outputs","id":"J7ACRk4rl57HLWvTeuNU0","children":[],"key":"MB5Uj6KkjK"}],"key":"A2HJQWk8DQ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Do some global integrals, to check if our values look reasonable","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fWKqX3UMQY"}],"identifier":"do-some-global-integrals-to-check-if-our-values-look-reasonable","label":"Do some global integrals, to check if our values look reasonable","html_id":"do-some-global-integrals-to-check-if-our-values-look-reasonable","implicit":true,"key":"OnOt5Z2hFv"}],"key":"KPHce19oYl"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds_glb = global_mean(ds, ds_grid, variables,normalize=False).compute()\n\n# convert from nmol C/s to Pg C/yr\nnmols_to_PgCyr = 1e-9 * 12. * 1e-15 * 365. * 86400.\n\nfor v in variables:\n    ds_glb[v] = ds_glb[v] * nmols_to_PgCyr        \n    ds_glb[v].attrs['units'] = 'Pg C yr$^{-1}$'\n    \nds_glb","key":"l9nbIC4nN8"},{"type":"outputs","id":"LuYxqcsy9AG6CM5Tt-Esu","children":[],"key":"JKidYMzr8V"}],"key":"MT1VSjubae"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We can compare these values to some observationally derived values. Each of these is calculated in a different way with combinations of data and models--please reference each linked paper for detailed discussion. ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dW71oYdkLH"},{"type":"cite","url":"https://doi.org/10.1016/S0967-0645(02)00003-6","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Takahashi et al., 2002","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"g91exyh9xY"}],"kind":"narrative","label":"Takahashi_2002","identifier":"https://doi.org/10.1016/S0967-0645(02)00003-6","enumerator":"1","key":"Kk27pBAXla"},{"type":"text","value":" estimate global air-sea CO","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cLTQC1T4MM"},{"type":"inlineMath","value":"_2","position":{"start":{"line":1,"column":1},"end"