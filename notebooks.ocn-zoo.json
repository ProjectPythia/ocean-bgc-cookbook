 = 's3://pythia/ocean-bgc/obs/copepod-2012__cmass-m00-qtr.zarr'\n\ncopepod_obs = s3fs.S3Map(root=copepod_obs_path, s3=s3)\n\nds_copepod = xr.open_dataset(copepod_obs, engine=\"zarr\")\n\n### converting grams to moles\nds_copepod['copepod_C']=ds_copepod.copepod_C/12.011","key":"Aqx3JyflfC"},{"type":"output","id":"qKHKrZzzrwaue4aRWoJS-","data":[],"key":"QHopFaiRrh"}],"key":"jqCJYpqIHG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds_copepod","key":"pM7klgrDCd"},{"type":"output","id":"At3viF8EE0eL66fga6Uh3","data":[],"key":"ohLHJtWyOH"}],"key":"t8UwocAzI2"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"V9x3E2uzKY"}],"identifier":"plot","label":"Plot","html_id":"plot","implicit":true,"key":"tRRN8zwutF"}],"key":"pmf4tP2VH7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(12,3))\n\nax = fig.add_subplot(1,2,1, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('COPEPOD dataset', fontsize=12)\npc=ax.pcolormesh(ds_copepod.lon, ds_copepod.lat, ds_copepod.copepod_C, cmap='Reds',vmin=0,vmax=2,transform=ccrs.PlateCarree())\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\nax = fig.add_subplot(1,2,2, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('CESM ${\\it Mesozooplankton}$ biomass', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats, ds_annual.mesozooC.mean(dim='z_t_150m'))\npc=ax.pcolormesh(lon, lat, field, cmap='Reds',vmin=0,vmax=2,transform=ccrs.PlateCarree())\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\nfig.subplots_adjust(right=0.8)\ncbar_ax = fig.add_axes([0.85, 0.15, 0.02, 0.7])\nfig.colorbar(pc, cax=cbar_ax,extend='max', label='top 150m/200m mean (mmol m$^{-3}$)');","key":"lo8MpDjMHB"},{"type":"output","id":"IB6_s9pNaLLftzkKmle1-","data":[],"key":"fPVHBsjejC"}],"key":"SKSbG4kXd7"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Making monthly climatology maps to compare to observations","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Z2Yju5mUhn"}],"identifier":"making-monthly-climatology-maps-to-compare-to-observations","label":"Making monthly climatology maps to compare to observations","html_id":"making-monthly-climatology-maps-to-compare-to-observations","implicit":true,"key":"HZ0K4j50Sv"}],"key":"EEJkX2dj1J"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare to observation-based GLMM (Generalized Linear Mixed Model) of global mesozooplankton biomass climatology","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mUN7R3025H"}],"identifier":"compare-to-observation-based-glmm-generalized-linear-mixed-model-of-global-mesozooplankton-biomass-climatology","label":"Compare to observation-based GLMM (Generalized Linear Mixed Model) of global mesozooplankton biomass climatology","html_id":"compare-to-observation-based-glmm-generalized-linear-mixed-model-of-global-mesozooplankton-biomass-climatology","implicit":true,"key":"gxivAmOvw0"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"This data is from ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"XQM8F5brvr"},{"type":"cite","url":"https://doi.org/10.1016/j.ecolmodel.2020.109265","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Heneghan et al., 2020","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"rZIU3kBUIM"}],"kind":"narrative","label":"Heneghan_2020","identifier":"https://doi.org/10.1016/j.ecolmodel.2020.109265","enumerator":"2","key":"ZT6IXeQomH"},{"type":"text","value":", which includes the COPEPOD dataset we used previously as well as additional observations, with some pre-processing.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"QfRJ5LieNv"}],"key":"bcVAGc8ND9"}],"key":"TiRG6WeQid"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mesozoo_obs_path = 'data/obsglmm_zmeso_vint_200m_monthly_climatology.nc'\n\nds_copepod_clim = xr.open_dataset(mesozoo_obs_path)\nds_copepod_clim.zmeso200.attrs['units'] = 'mgC m-2'\n\nmonths = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']","key":"V2OHkbnepY"},{"type":"output","id":"heBj15aqbm5eP70z_i5BU","data":[],"key":"tDpTogsZ11"}],"key":"BPyh91PQ5Y"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Make our CESM data into a monthly climatology","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"uYtevD6x47"}],"identifier":"make-our-cesm-data-into-a-monthly-climatology","label":"Make our CESM data into a monthly climatology","html_id":"make-our-cesm-data-into-a-monthly-climatology","implicit":true,"key":"KXhzzQ1P2q"}],"key":"ypV3cDodFe"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mon_ds = ds.copy()\nmon_ds = ds.groupby('time.month').mean('time')","key":"DlqH9EjN3L"},{"type":"output","id":"ttzj0PqvLCh3IfVb5Hn50","