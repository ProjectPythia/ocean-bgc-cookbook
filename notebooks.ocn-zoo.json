ue":"Connect to cluster","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dqJB9Z4v5b"}],"identifier":"connect-to-cluster","label":"Connect to cluster","html_id":"connect-to-cluster","implicit":true,"key":"RVjyyCU873"}],"key":"tBkXbq34tF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"cluster = LocalCluster()\nclient = cluster.get_client()","key":"XYmSGJyX9H"},{"type":"output","id":"-YPIHzRxr5MZaiq6x2eZo","data":[],"key":"FMJocR7JMe"}],"key":"KafJ6NMWRQ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Bring in POP grid utilities","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vOLbNU5bfY"}],"identifier":"bring-in-pop-grid-utilities","label":"Bring in POP grid utilities","html_id":"bring-in-pop-grid-utilities","implicit":true,"key":"gCiS2tDTGi"}],"key":"gORxC1zKxw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds_grid = pop_tools.get_grid('POP_gx1v7')\nlons = ds_grid.TLONG\nlats = ds_grid.TLAT\ndepths = ds_grid.z_t * 0.01","key":"FffzQvHZeh"},{"type":"output","id":"XGmaYU3nIn5CIyfBfUYtW","data":[],"key":"k220SqmTSJ"}],"key":"mMhFuqZkZB"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Load the data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KTUVVSzx4C"}],"identifier":"load-the-data","label":"Load the data","html_id":"load-the-data","implicit":true,"key":"FjgXOL44iY"}],"key":"xdu6Heqqhg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"jetstream_url = 'https://js2.jetstream-cloud.org:8001/'\n\ns3 = s3fs.S3FileSystem(anon=True, client_kwargs=dict(endpoint_url=jetstream_url))\n\n# Generate a list of all files in CESM folder\ns3path = 's3://pythia/ocean-bgc/cesm/g.e22.GOMIPECOIAF_JRA-1p4-2018.TL319_g17.4p2z.002branch/ocn/proc/tseries/month_1/*'\nremote_files = s3.glob(s3path)\n\n# Open all files from folder\nfileset = [s3.open(file) for file in remote_files]\n\n# Open with xarray\nds = xr.open_mfdataset(fileset, data_vars=\"minimal\", coords='minimal', compat=\"override\", parallel=True,\n                       drop_variables=[\"transport_components\", \"transport_regions\", 'moc_components'], decode_times=True)\n\nds","key":"K5Hoi40w54"},{"type":"output","id":"DI2Zycs5KE_Azx7KXXFqN","data":[],"key":"Aodt3Tkubt"}],"key":"dPiFQw62xd"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Subsetting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"H3gr4rsFW3"}],"identifier":"subsetting","label":"Subsetting","html_id":"subsetting","implicit":true,"key":"CWDB4m6RWV"}],"key":"xFNWYnKmZE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"variables =['mesozooC', 'microzooC']","key":"XeT5uXwwhs"},{"type":"output","id":"U9c34djp6Uf5MTAVBiwdU","data":[],"key":"o3eeB8yT7c"}],"key":"ugZOTh3Dq6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"keep_vars=['z_t','z_t_150m','dz','time_bound','time','TAREA','TLAT','TLONG'] + variables\nds = ds.drop_vars([v for v in ds.variables if v not in keep_vars])","key":"i23QP40q5T"},{"type":"output","id":"AYs18HZUQVIWHGSEN3Jrq","data":[],"key":"b4BD7dowca"}],"key":"LLzyr2dnX8"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Processing - long-term mean","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wc6E2dPnEF"}],"identifier":"processing-long-term-mean","label":"Processing - long-term mean","html_id":"processing-long-term-mean","implicit":true,"key":"s0daVe01Xs"}],"key":"IAPCXLaIdc"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pull in the function we defined in the nutrients notebook...","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qexku2xJG0"}],"key":"m75fn300VV"}],"key":"JVcAe7YYWZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the weights for each year is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")","key":"TJC2MfvWxi"},{"type":"output","id":"OSr2sPgy1qV0R3wi4a55z","data":[],"key":"b5ehRgbBbH"}],"key":"LcnNVOlfo3"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Take the long-term mean of our data set, processing years and months separately\n\nds_annual = year_mean(ds).mean(\"year\")","key":"yh2vFSjwyy"},{"type":"output","id":"yKuVivoxlDLc3ucVMnBQQ","data":[],"key":"EuroRlKP5w"}],"key":"zAfCSt2ymw"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot mesozooplankton and microzooplankton biomass at the surface","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"w24Rg4FyzB"}],"identifier":"plot-mesozooplankton-and-microzooplankton-biomass-at-the-surface","label":"Plot mesozooplankton and microzooplankton biomass at the surface","html_id":"plot-mesozooplankton-and-microzooplankton-biomass-at-the-surface","implicit":true,"key":"sR1yQ2B5pX"}],"key":"HkbZScMuQ1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(8,5))\n\nax = fig.add_subplot(2,1,1, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('microzooC at surface', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats,  ds_annual.microzooC.isel(z_t_150m=0))\npc=ax.pcolormesh(lon, lat, field, cmap='Blues',vmin=0,vmax=2,transform=ccrs.PlateCarree())\ncbar1 = fig.colorbar(pc, ax=ax,extend='max',label='microzooC (mmol m$^{-3}$)')\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\n\nax = fig.add_subplot(2,1,2, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('mesozooC at surface', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats,  ds_annual.mesozooC.isel(z_t_150m=0))\npc=ax.pcolormesh(lon, lat, field, cmap='Oranges',vmin=0,vmax=4,transform=ccrs.PlateCarree())\ncbar1 = fig.colorbar(pc, ax=ax,extend='max',label='mesozooC (mmol m$^{-3}$)')\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)","key":"ONkm0vmxSg"},{"type":"output","id":"eSvZK4g5muWcfckuoh5Rp","data":[],"key":"sEUHrZRUkz"}],"key":"KBFWHfKI66"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare mesozooplankton biomass to COPEPOD database","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"v0yU14ETc3"}],"identifier":"compare-mesozooplankton-biomass-to-copepod-database","label":"Compare mesozooplankton biomass to COPEPOD database","html_id":"compare-mesozooplankton-biomass-to-copepod-database","implicit":true,"key":"gNmX0Aa0FC"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We use data compiled through the COPEPOD project ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"me3oYAPY5Y"},{"type":"cite","url":"https://doi.org/10.5194/essd-5-45-2013","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"(Moriarty & O’Brien, 2013)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"DurHRDuCyZ"}],"kind":"narrative","label":"Moriarty_2013","identifier":"https://doi.org/10.5194/essd-5-45-2013","enumerator":"1","key":"RVT1ZIcJP0"},{"type":"text","value":". This data has been pre-processed, but the raw data is available on the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Yxzh7XlPmf"},{"type":"link","url":"https://www.st.nmfs.noaa.gov/copepod/about/databases.html","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"COPEPOD website","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"n5LTYvNFQ5"}],"urlSource":"https://www.st.nmfs.noaa.gov/copepod/about/databases.html","key":"s8ImWRId7d"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zgprDfLYqr"}],"key":"iDq9hsnn4G"}],"key":"HJy0Fx7cHr"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Read in COPEPOD data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KXbslXr6fH"}],"identifier":"read-in-copepod-data","label":"Read in COPEPOD data","html_id":"read-in-copepod-data","implicit":true,"key":"Xmuu2isyNr"}],"key":"QGSmu2oeaV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"copepod_obs_path = 's3://pythia/ocean-bgc/obs/copepod-2012__cmass-m00-qtr.zarr'\n\ncopepod_obs = s3fs.S3Map(root=copepod_obs_path, s3=s3)\n\nds_copepod = xr.open_dataset(copepod_obs, engine=\"zarr\")\n\n### converting grams to moles\nds_copepod['copepod_C']=ds_copepod.copepod_C/12.011","key":"H4GcZISaRv"},{"type":"output","id":"uDXwZKnpY8YGGkI0DHoot","data":[],"key":"uhgXOEe488"}],"key":"mTQ1SQIUBy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds_copepod","key":"ddd79e78SB"},{"type":"output","id":"c9cAfZylLphF7dn_o3P6X","data":[],"key":"ipyV317nM3"}],"key":"ZpnGOVMnk3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VppLjz0YVY"}],"identifier":"plot","label":"Plot","html_id":"plot","implicit":true,"key":"wiGYRBQZtw"}],"key":"E0R8ADRbNA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(12,3))\n\nax = fig.add_subplot(1,2,1, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('COPEPOD dataset', fontsize=12)\npc=ax.pcolormesh(ds_copepod.lon, ds_copepod.lat, ds_copepod.copepod_C, cmap='Reds',vmin=0,vmax=2,transform=ccrs.PlateCarree())\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\nax = fig.add_subplot(1,2,2, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('CESM ${\\it Mesozooplankton}$ biomass', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats, ds_annual.mesozooC.mean(dim='z_t_150m'))\npc=ax.pcolormesh(lon, lat, field, cmap='Reds',vmin=0,vmax=2,transform=ccrs.PlateCarree())\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\nfig.subplots_adjust(right=0.8)\ncbar_ax = fig.add_axes([0.85, 0.15, 0.02, 0.7])\nfig.colorbar(pc, cax=cbar_ax,extend='max', label='top 150m/200m mean (mmol m$^{-3}$)');","key":"Mv3k2ehnVI"},{"type":"output","id":"bCYRtEaly9zHamEqoKd4u","data":[],"key":"ulGMEcDAmm"}],"key":"A7AjdLEAxY"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Making monthly climatology maps to compare to observations","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XekyaUPlqc"}],"identifier":"making-monthly-climatology-maps-to-compare-to-observations","label":"Making monthly climatology maps to compare to observations","html_id":"making-monthly-climatology-maps-to-compare-to-observations","implicit":true,"key":"lGNP8babyj"}],"key":"uu1abggOWB"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare to observation-based GLMM (Generalized Linear Mixed Model) of global mesozooplankton biomass climatology","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tXDvRAaIdc"}],"identifier":"compare-to-observation-based-glmm-generalized-linear-mixed-model-of-global-mesozooplankton-biomass-climatology","label":"Compare to observation-based GLMM (Generalized Linear Mixed Model) of global mesozooplankton biomass climatology","html_id":"compare-to-observation-based-glmm-generalized-linear-mixed-model-of-global-mesozooplankton-biomass-climatology","implicit":true,"key":"doG9nd27DI"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"This data is from ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"KQbRIeFFrt"},{"type":"cite","url":"https://doi.org/10.1016/j.ecolmodel.2020.109265","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Heneghan et al., 2020","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Bjo8SeuMqX"}],"kind":"narrative","label":"Heneghan_2020","identifier":"https://doi.org/10.1016/j.ecolmodel.2020.109265","enumerator":"2","key":"CSDPubuxx5"},{"type":"text","value":", which includes the COPEPOD dataset we used previously as well as additional observations, with some pre-processing.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"dFLt3xsldz"}],"key":"ep7twErBVL"}],"key":"lqnrjifYrA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mesozoo_obs_path = 'data/obsglmm_zmeso_vint_200m_monthly_climatology.nc'\n\nds_copepod_clim = xr.open_dataset(mesozoo_obs_path)\nds_copepod_clim.zmeso200.attrs['units'] = 'mgC m-2'\n\nmonths = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']","key":"kggyJBpTF7"},{"type":"output","id":"aZWujWi4k49QqpcUObHFY","data":[],"key":"rqAbzkvDzY"}],"key":"MNwRn1VnvF"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Make our CESM data into a monthly climatology","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PPD7reRpVR"}],"identifier":"make-our-cesm-data-into-a-monthly-climatology","label":"Make our CESM data into a monthly climatology","html_id":"make-our-cesm-data-into-a-monthly-climatology","implicit":true,"key":"UxzZjs5eBs"}],"key":"QxknK7ezVO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mon_ds = ds.copy()\nmon_ds = ds.groupby('time.month').mean('time')","key":"jaoahIoddw"},{"type":"output","id":"wI2-9SmcXbx1Mjse1oLnE","data":[],"key":"QYHtAY3MP3"}],"key":"CSMKEZsdU0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"### depth integrate and convert model to mg C/m2\nmon_ds['mesozooC_zint'] = ((mon_ds.mesozooC) * 10.).sum(dim='z_t_150m') #in mmol/m2\nmon_ds['mesozooC_zint'] = mon_ds['mesozooC_zint'] * 12.011 #convert to mgC/m2\nmon_ds['mesozooC_zint'].attrs['units'] = 'mgC m-2'","key":"ysvQoL7Qa5"},{"type":"output","id":"aPd6saiK3LyJNZfpnjv_k","data":[],"key":"eXQe2kaB9A"}],"key":"mp4K4Xymyu"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dwTgK1A5e8"}],"identifier":"plot","label":"Plot","html_id":"plot-1","implicit":true,"key":"N7pPqAJz57"}],"key":"r586pXmolm"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(5,18))\n\nfor row in np.arange(1,13):\n    \n    ts=row-1\n    \n    plot = row*2 - 1\n    ax = fig.add_subplot(12,2,plot, projection=ccrs.Robinson(central_longitude=305.0))\n    ax.set_title(months[ts]+' obs', fontsize=12)\n    pc=ax.pcolormesh(ds_copepod_clim.Lon, ds_copepod_clim.Lat, ds_copepod_clim.zmeso200.isel(month=ts), \n                     cmap='Reds',vmin=0,vmax=4000,transform=ccrs.PlateCarree())\n    land = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\n    ax.add_feature(land)\n    \n    plot = row*2\n    ax = fig.add_subplot(12,2,plot, projection=ccrs.Robinson(central_longitude=305.0))\n    ax.set_title(months[ts]+' CESM', fontsize=12)\n    tmp = mon_ds.mesozooC_zint.isel(month=ts)\n    lon, lat, field = adjust_pop_grid(lons, lats,  tmp)\n    pc=ax.pcolormesh(lon, lat, field, cmap='Reds',vmin=0,vmax=4000,transform=ccrs.PlateCarree())\n    land = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\n    ax.add_feature(land)\n\ncbar_ax = fig.add_axes([0.92, 0.15, 0.03, 0.7])\nfig.colorbar(pc, cax=cbar_ax,extend='max', label='Depth-integrated copepod biomass (mg m$^{-2}$)');","key":"peVmNrZA3q"},{"type":"output","id":"ygXAnq_VBSClS7eI2UfoO","data":[],"key":"AaizfVaaEA"}],"key":"eH8Tz3sXjb"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"And close the Dask cluster we spun up at the beginning.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nDFXBElD1h"}],"key":"rV14IzCQjF"}],"key":"TJoklqlzLA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"cluster.close()","key":"mAjads8FXV"},{"type":"output","id":"y3UC4Rf-kDf9dF3t1zMLb","data":[],"key":"UHzHT7Zt8n"}],"key":"UJgVZUbx2L"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RVBMsZNM1w"}],"key":"L2B1ikNW91"},{"type":"block","kind":"notebook-content","data":{"jp-MarkdownHeadingCollapsed":true},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position"