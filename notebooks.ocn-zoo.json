ype":"code","lang":"python","executable":true,"value":"jetstream_url = 'https://js2.jetstream-cloud.org:8001/'\n\ns3 = s3fs.S3FileSystem(anon=True, client_kwargs=dict(endpoint_url=jetstream_url))\n\n# Generate a list of all files in CESM folder\ns3path = 's3://pythia/ocean-bgc/cesm/g.e22.GOMIPECOIAF_JRA-1p4-2018.TL319_g17.4p2z.002branch/ocn/proc/tseries/month_1/*'\nremote_files = s3.glob(s3path)\ns3.invalidate_cache()\n\n# Open all files from folder\nfileset = [s3.open(file) for file in remote_files]\n\n# Open with xarray\nds = xr.open_mfdataset(fileset, data_vars=\"minimal\", coords='minimal', compat=\"override\", parallel=True,\n                       drop_variables=[\"transport_components\", \"transport_regions\", 'moc_components'], decode_times=True)\n\nds","key":"j8wcJZgL0t"},{"type":"outputs","id":"rL2IGMa33IGkfwIeuHyS9","children":[],"key":"PlzHDkBPYG"}],"identifier":"37fb64e2-f0a3-4951-a480-7092b4ab04cd","html_id":"37fb64e2-f0a3-4951-a480-7092b4ab04cd","key":"RjU3Sw1RmT"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Subsetting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OdLMbABKJb"}],"identifier":"subsetting","label":"Subsetting","html_id":"subsetting","implicit":true,"key":"RI8XGfzmdm"}],"identifier":"50be6930-f48e-4d7a-9828-7b2766bf9bf2","html_id":"50be6930-f48e-4d7a-9828-7b2766bf9bf2","key":"Q5IHL5iI6d"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"variables =['mesozooC', 'microzooC']","key":"RdMBLFn1gz"},{"type":"outputs","id":"DqHWcq8HcDuZA2m16nEoE","children":[],"key":"zMVHPquMbj"}],"identifier":"ea5e9150-4e80-45a2-a5b6-a8b6a474cf72","html_id":"ea5e9150-4e80-45a2-a5b6-a8b6a474cf72","key":"HjxrnGyv1F"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"keep_vars=['z_t','z_t_150m','dz','time_bound','time','TAREA','TLAT','TLONG'] + variables\nds = ds.drop_vars([v for v in ds.variables if v not in keep_vars])","key":"achYn86zu9"},{"type":"outputs","id":"jH-XlWWlmP5kxa147slGM","children":[],"key":"o5S7wFRiD6"}],"identifier":"a63a74ea-ac56-4034-aeaa-f648909fe59a","html_id":"a63a74ea-ac56-4034-aeaa-f648909fe59a","key":"tYUxdF5EM5"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Processing - long-term mean","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"B8FwcCSfQn"}],"identifier":"processing-long-term-mean","label":"Processing - long-term mean","html_id":"processing-long-term-mean","implicit":true,"key":"DtLEKYrCkW"}],"identifier":"febdf9c0-a98c-49fa-b224-bbe085895384","html_id":"febdf9c0-a98c-49fa-b224-bbe085895384","key":"OQzkKfMBRY"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pull in the function we defined in the nutrients notebook...","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vksqdpFIul"}],"key":"Sv62TaM4tO"}],"identifier":"65b8fc08-c579-4353-bacf-af1b4f11d33d","html_id":"65b8fc08-c579-4353-bacf-af1b4f11d33d","key":"e6EFLnHsal"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the weights for each year is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")","key":"feioDKnQDY"},{"type":"outputs","id":"fochdm2R0jf0kRClgaq-5","children":[],"key":"dL7hQufjd2"}],"identifier":"5ee51015-79b5-4953-924f-ff788cc69d99","html_id":"5ee51015-79b5-4953-924f-ff788cc69d99","key":"ACFY2nPDqn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Take the long-term mean of our data set, processing years and months separately\n\nds_annual = year_mean(ds).mean(\"year\")","key":"ylP16e73OJ"},{"type":"outputs","id":"i4OgnSxIpEHLQYLPVZZp8","children":[],"key":"W1m1bvKL4c"}],"identifier":"ec7887be-7aea-47c8-be19-4bc681d2b71a","html_id":"ec7887be-7aea-47c8-be19-4bc681d2b71a","key":"yWBm2IllkQ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot mesozooplankton and microzooplankton biomass at the surface","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JleC2iu9hs"}],"identifier":"plot-mesozooplankton-and-microzooplankton-biomass-at-the-surface","label":"Plot mesozooplankton and microzooplankton biomass at the surface","html_id":"plot-mesozooplankton-and-microzooplankton-biomass-at-the-surface","implicit":true,"key":"UvaVf4dDLE"}],"identifier":"d18b05d1-034e-4671-b7c1-055dfb4c7828","html_id":"d18b05d1-034e-4671-b7c1-055dfb4c7828","key":"WRPeQlv6Sv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(8,5))\n\nax = fig.add_subplot(2,1,1, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('microzooC at surface', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats,  ds_annual.microzooC.isel(z_t_150m=0))\npc=ax.pcolormesh(lon, lat, field, cmap='Blues',vmin=0,vmax=2,transform=ccrs.PlateCarree())\ncbar1 = fig.colorbar(pc, ax=ax,extend='max',label='microzooC (mmol m$^{-3}$)')\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\n\nax = fig.add_subplot(2,1,2, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('mesozooC at surface', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats,  ds_annual.mesozooC.isel(z_t_150m=0))\npc=ax.pcolormesh(lon, lat, field, cmap='Oranges',vmin=0,vmax=4,transform=ccrs.PlateCarree())\ncbar1 = fig.colorbar(pc, ax=ax,extend='max',label='mesozooC (mmol m$^{-3}$)')\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)","key":"eOEgqiODoD"},{"type":"outputs","id":"n8ig5DTVbCx_yZmnwdYwx","children":[],"key":"N1v8aTUzwX"}],"identifier":"bff8e04c-c929-4159-8c04-208cad7285d6","html_id":"bff8e04c-c929-4159-8c04-208cad7285d6","key":"YrvWlgPRwE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare mesozooplankton biomass to COPEPOD database","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"o0uXsVME74"}],"identifier":"compare-mesozooplankton-biomass-to-copepod-database","label":"Compare mesozooplankton biomass to COPEPOD database","html_id":"compare-mesozooplankton-biomass-to-copepod-database","implicit":true,"key":"FqRbu4DP47"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We use data compiled through the COPEPOD project ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PM2McatqFl"},{"type":"cite","url":"https://doi.org/10.