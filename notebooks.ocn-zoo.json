e":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"variables =['mesozooC', 'microzooC']","key":"jK16ys2YEk"},{"type":"outputs","id":"635F4XNbAYGjupEwwUXvr","children":[],"key":"kKwiM0R3T6"}],"key":"pHAbnH7Lmp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"keep_vars=['z_t','z_t_150m','dz','time_bound','time','TAREA','TLAT','TLONG'] + variables\nds = ds.drop_vars([v for v in ds.variables if v not in keep_vars])","key":"VTRplmUb7Z"},{"type":"outputs","id":"-PtRZmQAte4kTt0T0jDsi","children":[],"key":"mIcNSmhePF"}],"key":"Ercfpi8tB3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Processing - long-term mean","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"W8sdcdsNQv"}],"identifier":"processing-long-term-mean","label":"Processing - long-term mean","html_id":"processing-long-term-mean","implicit":true,"key":"oWZjHe42gl"}],"key":"FkQjGZyaoI"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pull in the function we defined in the nutrients notebook...","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ux9b1V6aiI"}],"key":"JlEb3P6drM"}],"key":"iig4T7l9cJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the weights for each year is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")","key":"fC7m1dSFyW"},{"type":"outputs","id":"i3mKvM-XUGUZZf5_B2OW_","children":[],"key":"yPnjy6xe21"}],"key":"bDlXJQ4Gch"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Take the long-term mean of our data set, processing years and months separately\n\nds_annual = year_mean(ds).mean(\"year\")","key":"Ge4Gn11vSY"},{"type":"outputs","id":"wToohw4BsfDf5Y-xbdLmD","children":[],"key":"sVRG2WlRRO"}],"key":"Sfxu99rljB"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot mesozooplankton and microzooplankton biomass at the surface","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tVcEgObmTG"}],"identifier":"plot-mesozooplankton-and-microzooplankton-biomass-at-the-surface","label":"Plot mesozooplankton and microzooplankton biomass at the surface","html_id":"plot-mesozooplankton-and-microzooplankton-biomass-at-the-surface","implicit":true,"key":"muk5CpZ23R"}],"key":"EfLsjPlULd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(8,5))\n\nax = fig.add_subplot(2,1,1, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('microzooC at surface', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats,  ds_annual.microzooC.isel(z_t_150m=0))\npc=ax.pcolormesh(lon, lat, field, cmap='Blues',vmin=0,vmax=2,transform=ccrs.PlateCarree())\ncbar1 = fig.colorbar(pc, ax=ax,extend='max',label='microzooC (mmol m$^{-3}$)')\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\n\nax = fig.add_subplot(2,1,2, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('mesozooC at surface', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats,  ds_annual.mesozooC.isel(z_t_150m=0))\npc=ax.pcolormesh(lon, lat, field, cmap='Oranges',vmin=0,vmax=4,transform=ccrs.PlateCarree())\ncbar1 = fig.colorbar(pc, ax=ax,extend='max',label='mesozooC (mmol m$^{-3}$)')\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)","key":"mdz8P2wN3U"},{"type":"outputs","id":"AO5zX-xFpogBnHn0t9517","children":[],"key":"za8s7cmfMk"}],"key":"nMF5dgpHTC"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare mesozooplankton biomass to COPEPOD database","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hrA0ieYzRf"}],"identifier":"compare-mesozooplankton-biomass-to-copepod-database","label":"Compare mesozooplankton biomass to COPEPOD database","html_id":"compare-mesozooplankton-biomass-to-copepod-database","implicit":true,"key":"QtIlVyFfBB"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We use data compiled through the COPEPOD project ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"R4bCBUVh08"},{"type":"cite","url":"https://doi.org/10.5194/essd-5-45-2013","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"(Moriarty & O’Brien, 2013)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"q5dkzAHqwJ"}],"kind":"narrative","label":"Moriarty_2013","identifier":"https://doi.org/10.5194/essd-5-45-2013","enumerator":"1","key":"zqaSEdKVLv"},{"type":"text","value":". This data has been pre-processed, but the raw data is available on the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"FBlbIISzf4"},{"type":"link","url":"https://www.st.nmfs.noaa.gov/copepod/about/databases.html","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"COPEPOD website","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"iIPNJrnP33"}],"urlSource":"https://www.st.nmfs.noaa.gov/copepod/about/databases.html","key":"Vc8BTCgwFn"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"S0cUw8ijLD"}],"key":"RZrjdX10g8"}],"key":"s7YYBEmB3x"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Read in COPEPOD data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qPtFdOa6Aw"}],"identifier":"read-in-copepod-data","label":"Read in COPEPOD data","html_id":"read-in-copepod-data","implicit":true,"key":"uBSfc9s06J"}],"key":"KB9QyONtsQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"copepod_obs_path = 's3://pythia/ocean-bgc/obs/copepod-2012__cmass-m00-qtr.zarr'\n\ncopepod_obs = s3fs.S3Map(root=copepod_obs_path, s3=s3)\n\nds_copepod = xr.open_dataset(copepod_obs, engine=\"zarr\")\n\n### converting grams to moles\nds_copepod['copepod_C']=ds_copepod.copepod_C/12.011","key":"SlDMWocfgB"},{"type":"outputs","id":"oXbj66ly9hc6ybAvgD5Mo","children":[],"key":"qnqXuGsTqD"}],"key":"Ddp0tDhshO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds_copepod","key":"eIG1bbaDGj"},{"type":"outputs","id":"OAZGEju5MzAX6HUqSUyI1","children":[],"key":"Lz4ptIwPNt"}],"key":"ZY1dCyloDI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ANoUQ2rAAX"}],"identifier":"plot","label":"Plot","html_id":"plot","implicit":true,"key":"mSbLQDY14X"}],"key":"Ts2ufSiMFV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(12,3))\n\nax = fig.add_subplot(1,2,1, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('COPEPOD dataset', fontsize=12)\npc=ax.pcolormesh(ds_copepod.lon, ds_copepod.lat, ds_copepod.copepod_C, cmap='Reds',vmin=0,vmax=2,transform=ccrs.PlateCarree())\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\nax = fig.add_subplot(1,2,2, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('CESM ${\\it Mesozooplankton}$ biomass', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats, ds_annual.mesozooC.mean(dim='z_t_150m'))\npc=ax.pcolormesh(lon, lat, field, cmap='Reds',vmin=0,vmax=2,transform=ccrs.PlateCarree())\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\nfig.subplots_adjust(right=0.8)\ncbar_ax = fig.add_axes([0.85, 0.15, 0.02, 0.7])\nfig.colorbar(pc, cax=cbar_ax,extend='max', label='top 150m/200m mean (mmol m$^{-3}$)');","key":"gtXndJRNNx"},{"type":"outputs","id":"VhvI6Y_ItggaF7DvfZXY7","children":[],"key":"NzuvbqN5GH"}],"key":"HMiWG1ryZP"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Making monthly climatology maps to compare to observations","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"guLMdPsvrO"}],"identifier":"making-monthly-climatology-maps-to-compare-to-observations","label":"Making monthly climatology maps to compare to observations","html_id":"making-monthly-climatology-maps-to-compare-to-observations","implicit":true,"key":"PPwrHlnuTr"}],"key":"Oo4suEjice"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare to observation-based GLMM (Generalized Linear Mixed Model) of global mesozooplankton biomass climatology","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"F5h06So6Fx"}],"identifier":"compare-to-observation-based-glmm-generalized-linear-mixed-model-of-global-mesozooplankton-biomass-climatology","label":"Compare to observation-based GLMM (Generalized Linear Mixed Model) of global mesozooplankton biomass climatology","html_id":"compare-to-observation-based-glmm-generalized-linear-mixed-model-of-global-mesozooplankton-biomass-climatology","implicit":true,"key":"hniaFOQOjd"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"This data is from ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"w8RJW1uR9T"},{"type":"cite","url":"https://doi.org/10.1016/j.ecolmodel.2020.109265","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Heneghan et al., 2020","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"auzX1Y7f0i"}],"kind":"narrative","label":"Heneghan_2020","identifier":"https://doi.org/10.1016/j.ecolmodel.2020.109265","enumerator":"2","key":"T9oeTtpR3H"},{"type":"text","value":", which includes the COPEPOD dataset we used previously as well as additional observations, with some pre-processing.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"srLeSZ2feL"}],"key":"gM3BZfp4kL"}],"key":"EsyQBZsoU5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mesozoo_obs_path = 'data/obsglmm_zmeso_vint_200m_monthly_climatology.nc'\n\nds_copepod_clim = xr.open_dataset(mesozoo_obs_path)\nds_copepod_clim.zmeso200.attrs['units'] = 'mgC m-2'\n\nmonths = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']","key":"MzPqLIF4QA"},{"type":"outputs","id":"C_RBwvEXRx6S-Ysjn1LCF","children":[],"key":"lYBj3NZdyy"}],"key":"z0G3zDYRoG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Make our CESM data into a monthly climatology","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VTbt4afCzn"}],"identifier":"make-our-cesm-data-into-a-monthly-climatology","label":"Make our CESM data into a monthly climatology","html_id":"make-our-cesm-data-into-a-monthly-climatology","implicit":true,"key":"Tp8n9Dv4eY"}],"key":"ySzE32h8m0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mon_ds = ds.copy()\nmon_ds = ds.groupby('time.month').mean('time')","key":"nhRBnezBVF"},{"type":"outputs","id":"lFjwXk11hhxGFc6NGJANL","children":[],"key":"TXxXm28nzN"}],"key":"ZOhf7d9pQW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"### depth integrate and convert model to mg C/m2\nmon_ds['mesozooC_zint'] = ((mon_ds.mesozooC) * 10.).sum(dim='z_t_150m') #in mmol/m2\nmon_ds['mesozooC_zint'] = mon_ds['mesozooC_zint'] * 12.011 #convert to mgC/m2\nmon_ds['mesozooC_zint'].attrs['units'] = 'mgC m-2'","key":"TAyKlQqfaY"},{"type":"outputs","id":"6ypGoZCdR6_PQ3XlqyNrB","children":[],"key":"z0irQQo0eu"}],"key":"bLZri61cDt"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jUSc0k7r98"}],"identifier":"plot","label":"Plot","html_id":"plot-1","implicit":true,"key":"qxe09CzWMK"}],"key":"w3shvrQJz9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(5,18))\n\nfor row in np.arange(1,13):\n    \n    ts=row-1\n    \n    plot = row*2 - 1\n    ax = fig.add_subplot(12,2,plot, projection=ccrs.Robinson(central_longitude=305.0))\n    ax.set_title(months[ts]+' obs', fontsize=12)\n    pc=ax.pcolormesh(ds_copepod_clim.Lon, ds_copepod_clim.Lat, ds_copepod_clim.zmeso200.isel(month=ts), \n                     cmap='Reds',vmin=0,vmax=4000,transform=ccrs.PlateCarree())\n    land = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\n    ax.add_feature(land)\n    \n    plot = row*2\n    ax = fig.add_subplot(12,2,plot, projection=ccrs.Robinson(central_longitude=305.0))\n    ax.set_title(months[ts]+' CESM', fontsize=12)\n    tmp = mon_ds.mesozooC_zint.isel(month=ts)\n    lon, lat, field = adjust_pop_grid(lons, lats,  tmp)\n    pc=ax.pcolormesh(lon, lat, field, cmap='Reds',vmin=0,vmax=4000,transform=ccrs.PlateCarree())\n    land = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\n    ax.add_feature(land)\n\ncbar_ax = fig.add_axes([0.92, 0.15, 0.03, 0.7])\nfig.colorbar(pc, cax=cbar_ax,extend='max', label='Depth-integrated copepod biomass (mg m$^{-2}$)');","key":"DNw8HH7RVJ"},{"type":"outputs","id":"ydeD5ChIfD-Mzs1zreZZl","children":[],"key":"O3xbh7DNNV"}],"key":"o8GQaLT3aZ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"childre