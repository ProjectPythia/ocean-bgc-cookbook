,"key":"US7DON0FHe"}],"key":"GqlRJZGn8q"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Bring in POP grid utilities","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ioqSFDWAKg"}],"identifier":"bring-in-pop-grid-utilities","label":"Bring in POP grid utilities","html_id":"bring-in-pop-grid-utilities","implicit":true,"key":"QRhgHxAZhA"}],"key":"eTtl9KM1kd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds_grid = pop_tools.get_grid('POP_gx1v7')\nlons = ds_grid.TLONG\nlats = ds_grid.TLAT\ndepths = ds_grid.z_t * 0.01","key":"OFc1EgV7AR"},{"type":"output","id":"pYD6Dp5uEBT54wM3g11he","data":[],"key":"hhthjT7d6A"}],"key":"wvkeRbrPJ9"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Load the data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ite3O6xvqM"}],"identifier":"load-the-data","label":"Load the data","html_id":"load-the-data","implicit":true,"key":"raTdCiiE3o"}],"key":"XJKfTtGXY6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"jetstream_url = 'https://js2.jetstream-cloud.org:8001/'\n\ns3 = s3fs.S3FileSystem(anon=True, client_kwargs=dict(endpoint_url=jetstream_url))\n\n# Generate a list of all files in CESM folder\ns3path = 's3://pythia/ocean-bgc/cesm/g.e22.GOMIPECOIAF_JRA-1p4-2018.TL319_g17.4p2z.002branch/ocn/proc/tseries/month_1/*'\nremote_files = s3.glob(s3path)\n\n# Open all files from folder\nfileset = [s3.open(file) for file in remote_files]\n\n# Open with xarray\nds = xr.open_mfdataset(fileset, data_vars=\"minimal\", coords='minimal', compat=\"override\", parallel=True,\n                       drop_variables=[\"transport_components\", \"transport_regions\", 'moc_components'], decode_times=True)\n\nds","key":"BT5B1qurAs"},{"type":"output","id":"QpcysYMjffh-hWC2bO-1-","data":[],"key":"RowQdSMLfM"}],"key":"XNu1yPjCix"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Subsetting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xcyLajoEEt"}],"identifier":"subsetting","label":"Subsetting","html_id":"subsetting","implicit":true,"key":"Nkz4yOsAVs"}],"key":"FL4aWmuKrD"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"variables =['mesozooC', 'microzooC']","key":"E7KBCRUoqo"},{"type":"output","id":"GybwthmF7-q6J4oo9G1ve","data":[],"key":"RjbsVJXhhe"}],"key":"dMmw7selvA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"keep_vars=['z_t','z_t_150m','dz','time_bound','time','TAREA','TLAT','TLONG'] + variables\nds = ds.drop_vars([v for v in ds.variables if v not in keep_vars])","key":"XMMVjkABiD"},{"type":"output","id":"nzPGyZSUW7eqqpzbxTyjc","data":[],"key":"Bion6fFtvb"}],"key":"UTCULewHyp"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Processing - long-term mean","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zFPDed3Ew3"}],"identifier":"processing-long-term-mean","label":"Processing - long-term mean","html_id":"processing-long-term-mean","implicit":true,"key":"EKnS7Imk3N"}],"key":"Vssy09Yao2"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pull in the function we defined in the nutrients notebook...","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZSKojBlFVc"}],"key":"D8WwhI9BYr"}],"key":"KpknPBXJKz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the weights for each year is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")","key":"uuXPgj2c99"},{"type":"output","id":"YDbpHYoIvyfqW8zK-hP1A","data":[],"key":"VmovERnLpn"}],"key":"a5vEoFPSsa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Take the long-term mean of our data set, processing years and months separately\n\nds_annual = year_mean(ds).mean(\"year\")","key":"ETQ58AGkw5"},{"type":"output","id":"JD_A4tkKkz1gkvfWdSKzM","data":[],"key":"y5YKBIQPJB"}],"key":"AHPI3o5LU1"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot mesozooplankton and microzooplankton biomass at the surface","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"akfm7bXTHw"}],"identifier":"plot-mesozooplankton-and-microzooplankton-biomass-at-the-surface","label":"Plot mesozooplankton and microzooplankton biomass at the surface","html_id":"plot-mesozooplankton-and-microzooplankton-biomass-at-the-surface","implicit":true,"key":"vOnEXjTFia"}],"key":"UBFxyEPswU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(8,5))\n\nax = fig.add_subplot(2,1,1, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('microzooC at surface', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats,  ds_annual.microzooC.isel(z_t_150m=0))\npc=ax.pcolormesh(lon, lat, field, cmap='Blues',vmin=0,vmax=2,transform=ccrs.PlateCarree())\ncbar1 = fig.colorbar(pc, ax=ax,extend='max',label='microzooC (mmol m$^{-3}$)')\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\n\nax = fig.add_subplot(2,1,2, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('mesozooC at surface', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats,  ds_annual.mesozooC.isel(z_t_150m=0))\npc=ax.pcolormesh(lon, lat, field, cmap='Oranges',vmin=0,vmax=4,transform=ccrs.PlateCarree())\ncbar1 = fig.colorbar(pc, ax=ax,extend='max',label='mesozooC (mmol m$^{-3}$)')\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)","key":"Oesd2yGGKc"},{"type":"output","id":"VR3TGcmWSugh2OlEvfIhA","data":[],"key":"NCMNm0MMj6"}],"key":"adEuNMWso1"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare mesozooplankton biomass to COPEPOD database","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"payILQjpBT"}],"identifier":"compare-mesozooplankton-biomass-to-copepod-database","label":"Compare mesozooplankton biomass to COPEPOD database","html_id":"compare-mesozooplankton-biomass-to-copepod-database","implicit":true,"key":"x4N9J29Nw3"},{"type":"paragra