ozooC.mean(dim='z_t_150m'))\npc=ax.pcolormesh(lon, lat, field, cmap='Reds',vmin=0,vmax=2,transform=ccrs.PlateCarree())\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\nfig.subplots_adjust(right=0.8)\ncbar_ax = fig.add_axes([0.85, 0.15, 0.02, 0.7])\nfig.colorbar(pc, cax=cbar_ax,extend='max', label='top 150m/200m mean (mmol m$^{-3}$)');","key":"yM4jgFGgRZ"},{"type":"outputs","id":"mxmL5ehhABOKyRlVuY5Rp","children":[],"key":"IkH9f1PfHd"}],"identifier":"8f2f80dd-b738-437c-8ff7-1c6dc7423b74","html_id":"8f2f80dd-b738-437c-8ff7-1c6dc7423b74","key":"zEKYNAmZQK"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Making monthly climatology maps to compare to observations","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oMqHrnmw1R"}],"identifier":"making-monthly-climatology-maps-to-compare-to-observations","label":"Making monthly climatology maps to compare to observations","html_id":"making-monthly-climatology-maps-to-compare-to-observations","implicit":true,"key":"tQvDLGOyCm"}],"identifier":"0a4c0e5d-aaa7-446a-81e8-c1ae3f60d94e","html_id":"0a4c0e5d-aaa7-446a-81e8-c1ae3f60d94e","key":"IvSN0YI2q9"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare to observation-based GLMM (Generalized Linear Mixed Model) of global mesozooplankton biomass climatology","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wYciSD8Zwg"}],"identifier":"compare-to-observation-based-glmm-generalized-linear-mixed-model-of-global-mesozooplankton-biomass-climatology","label":"Compare to observation-based GLMM (Generalized Linear Mixed Model) of global mesozooplankton biomass climatology","html_id":"compare-to-observation-based-glmm-generalized-linear-mixed-model-of-global-mesozooplankton-biomass-climatology","implicit":true,"key":"o2z8Alp3f3"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"This data is from ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"rK5j1gvKOo"},{"type":"cite","url":"https://doi.org/10.1016/j.ecolmodel.2020.109265","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Heneghan et al., 2020","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"SbT0p18ZAf"}],"kind":"narrative","label":"Heneghan2020functional","identifier":"https://doi.org/10.1016/j.ecolmodel.2020.109265","enumerator":"2","key":"RAMGcFLtat"},{"type":"text","value":", which includes the COPEPOD dataset we used previously as well as additional observations, with some pre-processing.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"TWOFW7RqTd"}],"key":"JGkmRJi5KO"}],"identifier":"5085ee6d-457c-46dd-9beb-5b8f08d46473","html_id":"5085ee6d-457c-46dd-9beb-5b8f08d46473","key":"hUqNV9kT4l"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mesozoo_obs_path = 'data/obsglmm_zmeso_vint_200m_monthly_climatology.nc'\n\nds_copepod_clim = xr.open_dataset(mesozoo_obs_path)\nds_copepod_clim.zmeso200.attrs['units'] = 'mgC m-2'\n\nmonths = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']","key":"Re37eBXWok"},{"type":"outputs","id":"jrFPSe9VsUkNrDj1wwcmv","children":[],"key":"vaOYOQLODi"}],"identifier":"4ce3182e-deaa-4594-bb84-2eb8f7874fb8","html_id":"4ce3182e-deaa-4594-bb84-2eb8f7874fb8","key":"Ij79WXelnr"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Make our CESM data into a monthly climatology","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eM8iaa4Bt9"}],"identifier":"make-our-cesm-data-into-a-monthly-climatology","label":"Make our CESM data into a monthly climatology","html_id":"make-our-cesm-data-into-a-monthly-climatology","implicit":true,"key":"kKOgv8168Y"}],"identifier":"a8982df2-5cb7-47e1-a48f-8f6041e9c0d3","html_id":"a8982df2-5cb7-47e1-a48f-8f6041e9c0d3","key":"VmfYqwhoMp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mon_ds = ds.copy()\nmon_ds = ds.groupby('time.month').mean('time')","key":"Y060RlAstr"},{"type":"outputs","id":"t3FLfeQS6O8dM6V2ysFkH","children":[],"key":"YZasKHZFAd"}],"identifier":"950e227c-396c-4217-86d0-d31b0e6275e8","html_id":"950e227c-396c-4217-86d0-d31b0e6275e8","key":"pDA73ZisYm"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"### depth integrate and convert model to mg C/m2\nmon_ds['mesozooC_zint'] = ((mon_ds.mesozooC) * 10.).sum(dim='z_t_150m') #in mmol/m2\nmon_ds['mesozooC_zint'] = mon_ds['mesozooC_zint'] * 12.011 #convert to mgC/m2\nmon_ds['mesozooC_zint'].attrs['units'] = 'mgC m-2'","key":"Z4WlWIQSLO"},{"type":"outputs","id":"INJJ3HwfCO1PtCdeL938f","children":[],"key":"QxgWnIrGWV"}],"identifier":"94bda07d-0f2d-4940-9e7a-3fecb1d9aefe","html_id":"94bda07d-0f2d-4940-9e7a-3fecb1d9aefe","key":"XJh8bcFLFa"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zQGDr2IstZ"}],"identifier":"plot","label":"Plot","html_id":"plot-1","implicit":true,"key":"vc1c6YfXrF"}],"identifier":"9b1c6f93-4ebe-482b-8e50-0bd268881263","html_id":"9b1c6f93-4ebe-482b-8e50-0bd268881263","key":"nPyPRbyRM3"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(5,18))\n\nfor row in np.arange(1,13):\n    \n    ts=row-1\n    \n    plot = row*2 - 1\n    ax = fig.add_subplot(12,2,plot, projection=ccrs.Robinson(central_longitude=305.0))\n    ax.set_title(months[ts]+' obs', fontsize=12)\n    pc=ax.pcolormesh(ds_copepod_clim.Lon, ds_copepod_clim.Lat, ds_copepod_clim.zmeso200.isel(month=ts), \n                     cmap='Reds',vmin=0,vmax=4000,transform=ccrs.PlateCarree())\n    land = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\n    ax.add_feature(land)\n    \n    plot = row*2\n    ax = fig.add_subplot(12,2,plot, projection=ccrs.Robinson(central_longitude=305.0))\n    ax.set_title(months[ts]+' CESM', fontsize=12)\n    tmp = mon_ds.mesozooC_zint.isel(month=ts)\n    lon, lat, field = adjust_pop_grid(lons, lats,  tmp)\n    pc=ax.pcolormesh(lon, lat, field, cmap='Reds',vmin=0,vmax=4000,transform=ccrs.PlateCarree())\n    land = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\n    ax.add_feature(land)\n\ncbar_ax = fig.add_axes([0.92, 0.15, 0.03, 0.7])\nfig.colorbar(pc, cax=cbar_ax,extend='max', label='Depth-integrated copepod biomass (mg m$^{-2}$)');","key":"QSEQ6i4512"},{"type":"outputs","id":"c7lLpUzkudrX0wWwk1gQD","children":[],"key":"m1SV1r4IGC"}],"identifier":"6e28f6a9-7db6-4db0-860b-e64a6058911f","html_id":"6e28f6a9-7db6-4db0-860b-e64a6058911f","key":"iWqocXkytV"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"And close the Dask cluster we spun up at the beginning.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yzermeCg8g"}],"key":"R8wMMTj1fh"}],"identifier":"03fbe3b5-033d-4f90-a193-e86c16910878","html_id":"03fbe3b5-033d-4f90-a193-e86c16910878","key":"n4ivrhGt9F"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"cluster.close()","key":"Hecsyy7eQk"},{"type":"outputs","id":"S7LFkz54V2cATXiXkOokj","children":[],"key":"wxoOKO36JK"}],"identifier":"112a3ae1-7b90-4d35-babd-30f004a80ddd","html_id":"112a3ae1-7b90-4d35-babd-30f004a80ddd","key":"mSuJ253EQZ"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"B6loXEVPMC"}],"identifier":"a2e24edb-bc1a-46d1-89cc-19bea5d91bd9","html_id":"a2e24edb-bc1a-46d1-89cc-19bea5d91bd9","key":"ViCMcioIgC"},{"type":"block","kind":"notebook-content","data":{"jp-MarkdownHeadingCollapsed":true},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CjFrpG8NyS"}],"identifier":"summary","label":"Summary","html_id":"summary","implicit":true,"key":"IILVyGMcjX"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"You’ve learned how to evaluate zooplankton biomass modeled by CESM-MARBL and compare it to observations.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"kFvr26TqqN"}],"key":"H8Jn973dH4"}],"identifier":"d1851686-8ffa-4a47-8b60-b717bebca315","html_id":"d1851686-8ffa-4a47-8b60-b717bebca315","key":"h3RsDVQUrK"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Resources and references","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MJnEJznxlF"}],"identifier":"resources-and-references","label":"Resources and references","html_id"