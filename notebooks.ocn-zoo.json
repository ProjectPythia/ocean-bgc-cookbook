"}],"key":"atAvOhvuoG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Krz4V7jMP7"}],"identifier":"plot","label":"Plot","html_id":"plot","implicit":true,"key":"Lqjt1nW5sZ"}],"key":"UJwRawIw2u"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(12,3))\n\nax = fig.add_subplot(1,2,1, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('COPEPOD dataset', fontsize=12)\npc=ax.pcolormesh(ds_copepod.lon, ds_copepod.lat, ds_copepod.copepod_C, cmap='Reds',vmin=0,vmax=2,transform=ccrs.PlateCarree())\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\nax = fig.add_subplot(1,2,2, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('CESM ${\\it Mesozooplankton}$ biomass', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats, ds_annual.mesozooC.mean(dim='z_t_150m'))\npc=ax.pcolormesh(lon, lat, field, cmap='Reds',vmin=0,vmax=2,transform=ccrs.PlateCarree())\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\nfig.subplots_adjust(right=0.8)\ncbar_ax = fig.add_axes([0.85, 0.15, 0.02, 0.7])\nfig.colorbar(pc, cax=cbar_ax,extend='max', label='top 150m/200m mean (mmol m$^{-3}$)');","key":"CwIar4hSV1"},{"type":"outputs","id":"GhHjVni46WEAP3AsNYJAb","children":[],"key":"k6NLYjyLb5"}],"key":"MCkSvjVLhl"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Making monthly climatology maps to compare to observations","position":