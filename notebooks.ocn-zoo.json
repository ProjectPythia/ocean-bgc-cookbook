code","lang":"python","executable":true,"value":"jetstream_url = 'https://js2.jetstream-cloud.org:8001/'\n\ns3 = s3fs.S3FileSystem(anon=True, client_kwargs=dict(endpoint_url=jetstream_url))\n\n# Generate a list of all files in CESM folder\ns3path = 's3://pythia/ocean-bgc/cesm/g.e22.GOMIPECOIAF_JRA-1p4-2018.TL319_g17.4p2z.002branch/ocn/proc/tseries/month_1/*'\nremote_files = s3.glob(s3path)\ns3.invalidate_cache()\n\n# Open all files from folder\nfileset = [s3.open(file) for file in remote_files]\n\n# Open with xarray\nds = xr.open_mfdataset(fileset, data_vars=\"minimal\", coords='minimal', compat=\"override\", parallel=True,\n                       drop_variables=[\"transport_components\", \"transport_regions\", 'moc_components'], decode_times=True)\n\nds","key":"bWpXJbVfyI"},{"type":"outputs","id":"ztFHPN7nggkZa4IZF1G7t","children":[],"key":"UIkVZqy9Lv"}],"identifier":"37fb64e2-f0a3-4951-a480-7092b4ab04cd","html_id":"37fb64e2-f0a3-4951-a480-7092b4ab04cd","key":"wQfJaGc6xJ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Subsetting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ipE3ro98br"}],"identifier":"subsetting","label":"Subsetting","html_id":"subsetting","implicit":true,"key":"FyJznEK5lu"}],"identifier":"50be6930-f48e-4d7a-9828-7b2766bf9bf2","html_id":"50be6930-f48e-4d7a-9828-7b2766bf9bf2","key":"WA9SZXGIw1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"variables =['mesozooC', 'microzooC']","key":"s7MEhwk5GQ"},{"type":"outputs","id":"n9ZG0OD1QddZ5n0JBiGdc","children":[],"key":"HFzdfTfMfm"}],"identifier":"ea5e9150-4e80-45a2-a5b6-a8b6a474cf72","html_id":"ea5e9150-4e80-45a2-a5b6-a8b6a474cf72","key":"nfzt1jQWKT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"keep_vars=['z_t','z_t_150m','dz','time_bound','time','TAREA','TLAT','TLONG'] + variables\nds = ds.drop_vars([v for v in ds.variables if v not in keep_vars])","key":"eV3rFc70c0"},{"type":"outputs","id":"KHV19Ei6ZLdtmYB17w5iR","children":[],"key":"JWtfAPSFIU"}],"identifier":"a63a74ea-ac56-4034-aeaa-f648909fe59a","html_id":"a63a74ea-ac56-4034-aeaa-f648909fe59a","key":"SIhi4Bvwg2"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Processing - long-term mean","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Z2BBt7sKkk"}],"identifier":"processing-long-term-mean","label":"Processing - long-term mean","html_id":"processing-long-term-mean","implicit":true,"key":"rSVDxYtTM4"}],"identifier":"febdf9c0-a98c-49fa-b224-bbe085895384","html_id":"febdf9c0-a98c-49fa-b224-bbe085895384","key":"YldQZ8pTWd"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pull in the function we defined in the nutrients notebook...","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qECYycwftM"}],"key":"eTzavfOM43"}],"identifier":"65b8fc08-c579-4353-bacf-af1b4f11d33d","html_id":"65b8fc08-c579-4353-bacf-af1b4f11d33d","key":"MSGQsAKKB8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the weights for each year is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")","key":"xxbKZq2gfA"},{"type":"outputs","id":"IAaD2tJS6pV6Uu_CyZWpt","children":[],"key":"uiFSJjIU2j"}],"identifier":"5ee51015-79b5-4953-924f-ff788cc69d99","html_id":"5ee51015-79b5-4953-924f-ff788cc69d99","key":"RnJH5QEepl"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Take the long-term mean of our data set, processing years and months separately\n\nds_annual = year_mean(ds).mean(\"year\")","key":"arGaJvpzGo"},{"type":"outputs","id":"W4wPb6UAO_jen2ViEQVco","children":[],"key":"BE7XgV1VDx"}],"identifier":"ec7887be-7aea-47c8-be19-4bc681d2b71a","html_id":"ec7887be-7aea-47c8-be19-4bc681d2b71a","key":"r2h3VQiI7r"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot mesozooplankton and microzooplankton biomass at the surface","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Vj5hDobcaw"}],"identifier":"plot-mesozooplankton-and-microzooplankton-biomass-at-the-surface","label":"Plot mesozooplankton and microzooplankton biomass at the surface","html_id":"plot-mesozooplankton-and-microzooplankton-biomass-at-the-surface","implicit":true,"key":"h9B5ehkT5B"}],"identifier":"d18b05d1-034e-4671-b7c1-055dfb4c7828","html_id":"d18b05d1-034e-4671-b7c1-055dfb4c7828","key":"nQSo8i1e8y"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(8,5))\n\nax = fig.add_subplot(2,1,1, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('microzooC at surface', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats,  ds_annual.microzooC.isel(z_t_150m=0))\npc=ax.pcolormesh(lon, lat, field, cmap='Blues',vmin=0,vmax=2,transform=ccrs.PlateCarree())\ncbar1 = fig.colorbar(pc, ax=ax,extend='max',label='microzooC (mmol m$^{-3}$)')\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\n\nax = fig.add_subplot(2,1,2, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('mesozooC at surface', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats,  ds_annual.mesozooC.isel(z_t_150m=0))\npc=ax.pcolormesh(lon, lat, field, cmap='Oranges',vmin=0,vmax=4,transform=ccrs.PlateCarree())\ncbar1 = fig.colorbar(pc, ax=ax,extend='max',label='mesozooC (mmol m$^{-3}$)')\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)","key":"J90JkATLJQ"},{"type":"outputs","id":"OCG83cSGB6EEaMhEhd1_z","children":[],"key":"UaYjmx1981"}],"identifier":"bff8e04c-c929-4159-8c04-208cad7285d6","html_id":"bff8e04c-c929-4159-8c04-208cad7285d6","key":"xtNb2ZSUWA"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare mesozooplankton biomass to COPEPOD database","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JMxxQcfd6R"}],"identifier":"compare-mesozooplankton-biomass-to-copepod-database","label":"Compare mesozooplankton biomass to COPEPOD database","html_id":"compare-mesozooplankton-biomass-to-copepod-database","implicit":true,"key":"xal335iSTH"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We use data compiled through the COPEPOD project ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ur1Kp846Pd"},{"type":"cite","url":"https://doi.org/10.5194/essd-5-45-2013","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"(Moriarty & O’Brien, 2013)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Ve2qY3Ldjo"}],"kind":"narrative","label":"Moriarty_2013","identifier":"https://doi.org/10.5194/essd-5-45-2013","enumerator":"1","key":"BNqGFyHPOr"},{"type":"text","value":". This data has been pre-processed, but the raw data is available on the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"aZJwLDywoi"},{"type":"link","url":"https://www.st.nmfs.noaa.gov/copepod/about/databases.html","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"COPEPOD website","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"h4wC6Q9tFb"}],"urlSource":"https://www.st.nmfs.noaa.gov/copepod/about/databases.html","key":"p4JdPRa7wK"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"QXnyfIkhP7"}],"key":"vZrBEy3GMP"}],"identifier":"745e6a54-9175-48c4-8a9b-f52c2345b593","html_id":"745e6a54-9175-48c4-8a9b-f52c2345b593","key":"VpmV8nnQSl"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Read in COPEPOD data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CikloFHeC2"}],"identifier":"read-in-copepod-data","label":"Read in COPEPOD data","html_id":"read-in-copepod-data","implicit":true,"key":"mqnqmjuYkd"}],"identifier":"b59c9e72-4b8f-4e98-8724-a206416eacf0","html_id":"b59c9e72-4b8f-4e98-8724-a206416eacf0","key":"QO2RwD6CVW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"copepod_obs_path = 's3://pythia/ocean-bgc/obs/copepod-2012__cmass-m00-qtr.zarr'\n\ncopepod_obs = s3fs.S3Map(root=copepod_obs_path, s3=s3)\n\nds_copepod = xr.open_dataset(copepod_obs, engine=\"zarr\")\n\n### converting grams to moles\nds_copepod['copepod_C']=ds_copepod.copepod_C/12.011","key":"daw61Lcftl"},{"type":"outputs","id":"BTMtCatHo_lTH1zjIWwR_","children":[],"key":"ILw66ywvBK"}],"identifier":"12ebf98e-ecc4-4e7a-a41d-0acb21a21e3e","html_id":"12ebf98e-ecc4-4e7a-a41d-0acb21a21e3e","key":"nK3GGcftmW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds_copepod","key":"ZlcbTncotv"},{"type":"outputs","id":"-jW4ZSaPutGj12JaebzI_","children":[],"key":"WCEg6pIc24"}],"identifier":"0b6471bf-0d65-4cfb-9ce9-85cfcbeb3934","html_id":"0b6471bf-0d65-4cfb-9ce9-85cfcbeb3934","key":"omMQ6YbDYS"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zSvvsAzkmK"}],"identifier":"plot","label":"Plot","html_id":"plot","implicit":true,"key":"sp2wqPmgRV"}],"identifier":"3304c95d-9e96-403f-ac97-5450d2e8b0ab","html_id":"3304c95d-9e96-403f-ac97-5450d2e8b0ab","key":"yvEMoLobky"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(12,3))\n\nax = fig.add_subplot(1,2,1, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('COPEPOD dataset', fontsize=12)\npc=ax.pcolormesh(ds_copepod.lon, ds_copepod.lat, ds_copepod.copepod_C, cmap='Reds',vmin=0,vmax=2,transform=ccrs.PlateCarree())\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\nax = fig.add_subplot(1,2,2, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('CESM ${\\it Mesozooplankton}$ biomass', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats, ds_annual.mesozooC.mean(dim='z_t_150m'))\npc=ax.pcolormesh(lon, lat, field, cmap='Reds',vmin=0,vmax=2,transform=ccrs.PlateCarree())\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\nfig.subplots_adjust(right=0.8)\ncbar_ax = fig.add_axes([0.85, 0.15, 0.02, 0.7])\nfig.colorbar(pc, cax=cbar_ax,extend='max', label='top 150m/200m mean (mmol m$^{-3}$)');","key":"p0U25SEc32"},{"type":"outputs","id":"e_h9ydOiY6aLPjPmV3yBQ","children":[],"key":"abbVPSl7ST"}],"identifier":"8f2f80dd-b738-437c-8ff7-1c6dc7423b74","html_id":"8f2f80dd-b738-437c-8ff7-1c6dc7423b74","key":"y0YoqKHUFI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Making monthly climatology maps to compare to observations","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HjnPvpzUSv"}],"identifier":"making-monthly-climatology-maps-to-compare-to-observations","label":"Making monthly climatology maps to compare to observations","html_id":"making-monthly-climatology-maps-to-compare-to-observations","implicit":true,"key":"Y9XNoPfE4S"}],"identifier":"0a4c0e5d-aaa7-446a-81e8-c1ae3f60d94e","html_id":"0a4c0e5d-aaa7-446a-81e8-c1ae3f60d94e","key":"oHQbG8r1ZE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare to observation-based GLMM (Generalized Linear Mixed Model) of global mesozooplankton biomass climatology","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cHIHuLxmyP"}],"identifier":"compare-to-observation-based-glmm-generalized-linear-mixed-model-of-global-mesozooplankton-biomass-climatology","label":"Compare to observation-based GLMM (Generalized Linear Mixed Model) of global mesozooplankton biomass climatology","html_id":"compare-to-observation-based-glmm-generalized-linear-mixed-model-of-global-mesozooplankton-biomass-climatology","implicit":true,"key":"VeVYfidr2c"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"This data is from ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"xg7oxifqCH"},{"type":"cite","url":"https://doi.org/10.1016/j.ecolmodel.2020.109265","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Heneghan et al., 2020","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"rV9DG9RNkz"}],"kind":"narrative","label":"Heneghan_2020","identifier":"https://doi.org/10.1016/j.ecolmodel.2020.109265","enumerator":"2","key":"H4fhXEDX68"},{"type":"text","value":", which includes the COPEPOD dataset we used previously as well as additional observations, with some pre-processing.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"UFCGe3bsQ5"}],"key":"oAsBMCfaDm"}],"identifier":"5085ee6d-457c-46dd-9beb-5b8f08d46473","html_id":"5085ee6d-457c-46dd-9beb-5b8f08d46473","key":"LX4W2fOPgx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mesozoo_obs_path = 'data/obsglmm_zmeso_vint_200m_monthly_climatology.nc'\n\nds_copepod_clim = xr.open_dataset(mesozoo_obs_path)\nds_copepod_clim.zmeso200.attrs['units'] = 'mgC m-2'\n\nmonths = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']","key":"yfIIYNIaOd"},{"type":"outputs","id":"1mdCiP7nPcjpuoz64AKBp","children":[],"key":"Oz06RPzNAA"}],"identifier":"4ce3182e-deaa-4594-bb84-2eb8f7874fb8","html_id":"4ce3182e-deaa-4594-bb84-2eb8f7874fb8","key":"Exy4CKvD3P"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Make our CESM data into a monthly climatology","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Mh4FQFK5eV"}],"identifier":"make-our-cesm-data-into-a-monthly-climatology","label":"Make our CESM data into a monthly climatology","html_id":"make-our-cesm-data-into-a-monthly-climatology","implicit":true,"key":"AnP5t7RS2U"}],"identifier":"a8982df2-5cb7-47e1-a48f-8f6041e9c0d3","html_id":"a8982df2-5cb7-47e1-a48f-8f6041e9c0d3","key":"Meutd4xv99"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mon_ds = ds.copy()\nmon_ds = ds.groupby('time.month').mean('time')","key":"EmroPH3n3L"},{"type":"outputs","id":"hIpRY_ey3JrX6uVVQWR0e","children":[],"key":"LV213Gp5O6"}],"identifier":"950e227c-396c-4217-86d0-d31b0e6275e8","html_id":"950e227c-396c-4217-86d0-d31b0e6275e8","key":"vJZshOz21G"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"### depth integrate and convert model to mg C/m2\nmon_ds['mesozooC_zint'] = ((mon_ds.mesozooC) * 10.).sum(dim='z_t_150m') #in mmol/m2\nmon_ds['mesozooC_zint'] = mon_ds['mesozooC_zint'] * 12.011 #convert to mgC/m2\nmon_ds['mesozooC_zint'].attrs['units'] = 'mgC m-2'","key":"qcW7foVYdW"},{"type":"outputs","id":"6P18KMIe7_SCqI8QcqYXv","children":[],"key":"FYxLdWrRgO"}],"identifier":"94bda07d-0f2d-4940-9e7a-3fecb1d9aefe","html_id":"94bda07d-0f2d-4940-9e7a-3fecb1d9aefe","key":"eHmXarbstq"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kYxI9NX2YF"}],"identifier":"plot","label":"Plot","html_id":"plot-1","implicit":true,"key":"D6LZbYxL7t"}],"identifier":"9b1c6f93-4ebe-482b-8e50-0bd268881263","html_id":"9b1c6f93-4ebe-482b-8e50-0bd268881263","key":"t9tKWsKhE0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(5,18))\n\nfor row in np.arange(1,13):\n    \n    ts=row-1\n    \n    plot = row*2 - 1\n    ax = fig.add_subplot(12,2,plot, projection=ccrs.Robinson(central_longitude=305.0))\n    ax.set_title(months[ts]+' obs', fontsize=12)\n    pc=ax.pcolormesh(ds_copepod_clim.Lon, ds_copepod_clim.Lat, ds_copepod_clim.zmeso200.isel(month=ts), \n                     cmap='Reds',vmin=0,vmax=4000,transform=ccrs.PlateCarree())\n    land = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\n    ax.add_feature(land)\n    \n    plot = row*2\n    ax = fig.add_subplot(12,2,plot, projection=ccrs.Robinson(central_longitude=305.0))\n    ax.set_title(months[ts]+' CESM', fontsize=12)\n    tmp = mon_ds.mesozooC_zint.isel(month=ts)\n    lon, lat, field = adjust_pop_grid(lons, lats,  tmp)\n    pc=ax.pcolormesh(lon, lat, field, cmap='Reds',vmin=0,vmax=4000,transform=ccrs.PlateCarree())\n    land = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\n    ax.add_feature(land)\n\ncbar_ax = fig.add_axes([0.92, 0.15, 0.03, 0.7])\nfig.colorbar(pc, cax=cbar_ax,extend='max', label='Depth-integrated copepod biomass (mg m$^{-2}$)');","key":"TqC1lmsCHZ"},{"type":"outputs","id":"W84oNYH3l7R9XNi4X0W3A","children":[],"key":"LNnWToakXA"}],"identifier":"6e28f6a9-7db6-4db0-860b-e64a6058911f","html_id":"6e28f6a9-7db6-4db0-860b-e64a6058911f","key":"EytChZQ1FU"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"And close the Dask cluster we spun up at the beginning.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Qv0htwZbT4"}],"key":"KQYX1697hS"}],"identifier":"03fbe3b5-033d-4f90-a193-e86c16910878","html_id":"03fbe3b5-033d-4f90-a193-e86c16910878","key":"l6eZm8RA5r"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"cluster.close()","key":"A8vHBiB67V"},{"type":"outputs","id":"5l8KTLa3ZCR2EoBCwrb8N","children":[],"key":"f7EasFBbDq"}],"identifier":"112a3ae1-7b90-4d35-babd-30f004a80ddd","html_id":"112a3ae1-7b90-4d35-babd-30f004a80ddd","key":"GGB8JO5J3Z"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"W1WiMZ1JbG"}],"identifier":"a2e24edb-bc1a-46d1-89cc-19bea5d91bd9","html_id":"a2e24edb-bc1a-46d1-89cc-19bea5d91bd9","key":"isREiQqn7C"},{"type":"block","kind":"notebook-content","data":{"jp-MarkdownHeadingCollapsed":true},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MuQqqBXtRH"}],"identifier":"summary","label":"Summary","html_id":"summary","implicit":true,"key":"WPSEyMvbQP"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"You’ve learned how to evaluate zooplankton biomass modeled by CESM-MARBL and compare it to observations.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"cgFN3NL5MW"}],"key":"kJLeUb4VAZ"}],"identifier":"d1851686-8ffa-4a47-8b60-b717bebca315","html_id":"d1851686-8ffa-4a47-8b60-b717bebca315","key":"X5PGslYsaf"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Resources and references","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"a7T8VZUEBI"}],"identifier":"resources-and-references","label":"Resources and references","html_id":"resources-and