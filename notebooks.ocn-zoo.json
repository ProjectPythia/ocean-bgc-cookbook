ype":"code","lang":"python","executable":true,"value":"jetstream_url = 'https://js2.jetstream-cloud.org:8001/'\n\ns3 = s3fs.S3FileSystem(anon=True, client_kwargs=dict(endpoint_url=jetstream_url))\n\n# Generate a list of all files in CESM folder\ns3path = 's3://pythia/ocean-bgc/cesm/g.e22.GOMIPECOIAF_JRA-1p4-2018.TL319_g17.4p2z.002branch/ocn/proc/tseries/month_1/*'\nremote_files = s3.glob(s3path)\ns3.invalidate_cache()\n\n# Open all files from folder\nfileset = [s3.open(file) for file in remote_files]\n\n# Open with xarray\nds = xr.open_mfdataset(fileset, data_vars=\"minimal\", coords='minimal', compat=\"override\", parallel=True,\n                       drop_variables=[\"transport_components\", \"transport_regions\", 'moc_components'], decode_times=True)\n\nds","key":"A0Xt9Xjnpl"},{"type":"outputs","id":"DKZa1VNaqP2bNAe9DQRxv","children":[],"key":"KbnIH5ORtw"}],"identifier":"37fb64e2-f0a3-4951-a480-7092b4ab04cd","html_id":"37fb64e2-f0a3-4951-a480-7092b4ab04cd","key":"pWzf17ZN31"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Subsetting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"W3T0ffNhVr"}],"identifier":"subsetting","label":"Subsetting","html_id":"subsetting","implicit":true,"key":"AiJCDmkw2n"}],"identifier":"50be6930-f48e-4d7a-9828-7b2766bf9bf2","html_id":"50be6930-f48e-4d7a-9828-7b2766bf9bf2","key":"ZW3sDRI7ie"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"variables =['mesozooC', 'microzooC']","key":"CIRXrOA7uk"},{"type":"outputs","id":"Z3IOiFiI-v1Nm2_U_M3F8","children":[],"key":"GMFDWyM67V"}],"identifier":"ea5e9150-4e80-45a2-a5b6-a8b6a474cf72","html_id":"ea5e9150-4e80-45a2-a5b6-a8b6a474cf72","key":"d8ZDZLYIAV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"keep_vars=['z_t','z_t_150m','dz','time_bound','time','TAREA','TLAT','TLONG'] + variables\nds = ds.drop_vars([v for v in ds.variables if v not in keep_vars])","key":"ppKPwlQi8b"},{"type":"outputs","id":"QY9sPRy1RnoNccRasUD0O","children":[],"key":"sWXD9UeEfb"}],"identifier":"a63a74ea-ac56-4034-aeaa-f648909fe59a","html_id":"a63a74ea-ac56-4034-aeaa-f648909fe59a","key":"Phxx05h3HN"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Processing - long-term mean","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Oa8rJBWIVd"}],"identifier":"processing-long-term-mean","label":"Processing - long-term mean","html_id":"processing-long-term-mean","implicit":true,"key":"MVLEFSSJPy"}],"identifier":"febdf9c0-a98c-49fa-b224-bbe085895384","html_id":"febdf9c0-a98c-49fa-b224-bbe085895384","key":"uC7w2CP5yF"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pull in the function we defined in the nutrients notebook...","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Lwh6c4anek"}],"key":"cTg0fmRrtg"}],"identifier":"65b8fc08-c579-4353-bacf-af1b4f11d33d","html_id":"65b8fc08-c579-4353-bacf-af1b4f11d33d","key":"HxE6iH7aFy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the weights for each year is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")","key":"dEtb02aDp1"},{"type":"outputs","id":"F1fo3nmLZi_LpcXtQFdlO","children":[],"key":"Dzp5EA8P5n"}],"identifier":"5ee51015-79b5-4953-924f-ff788cc69d99","html_id":"5ee51015-79b5-4953-924f-ff788cc69d99","key":"GiNEKMQfOS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Take the long-term mean of our data set, processing years and months separately\n\nds_annual = year_mean(ds).mean(\"year\")","key":"p74j1nsUjn"},{"type":"outputs","id":"D2uV1FTwz6QAhNOn-sr4-","children":[],"key":"XU2jUiARpQ"}],"identifier":"ec7887be-7aea-47c8-be19-4bc681d2b71a","html_id":"ec7887be-7aea-47c8-be19-4bc681d2b71a","key":"n4ZCRjWDFR"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot mesozooplankton and microzooplankton biomass at the surface","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WIw3isiBCR"}],"identifier":"plot-mesozooplankton-and-microzooplankton-biomass-at-the-surface","label":"Plot mesozooplankton and microzooplankton biomass at the surface","html_id":"plot-mesozooplankton-and-microzooplankton-biomass-at-the-surface","implicit":true,"key":"aWvOYsZbmq"}],"identifier":"d18b05d1-034e-4671-b7c1-055dfb4c7828","html_id":"d18b05d1-034e-4671-b7c1-055dfb4c7828","key":"k6AXwED6n0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(8,5))\n\nax = fig.add_subplot(2,1,1, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('microzooC at surface', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats,  ds_annual.microzooC.isel(z_t_150m=0))\npc=ax.pcolormesh(lon, lat, field, cmap='Blues',vmin=0,vmax=2,transform=ccrs.PlateCarree())\ncbar1 = fig.colorbar(pc, ax=ax,extend='max',label='microzooC (mmol m$^{-3}$)')\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\n\nax = fig.add_subplot(2,1,2, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('mesozooC at surface', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats,  ds_annual.mesozooC.isel(z_t_150m=0))\npc=ax.pcolormesh(lon, lat, field, cmap='Oranges',vmin=0,vmax=4,transform=ccrs.PlateCarree())\ncbar1 = fig.colorbar(pc, ax=ax,extend='max',label='mesozooC (mmol m$^{-3}$)')\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)","key":"FpGVmzIbi4"},{"type":"outputs","id":"boQMdhXMco8MGA2F07LLs","children":[],"key":"ic62QHLnBM"}],"identifier":"bff8e04c-c929-4159-8c04-208cad7285d6","html_id":"bff8e04c-c929-4159-8c04-208cad7285d6","key":"epAHHnWhUE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare mesozooplankton biomass to COPEPOD database","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QLOSxGjolG"}],"identifier":"compare-mesozooplankton-biomass-to-copepod-database","label":"Compare mesozooplankton biomass to COPEPOD database","html_id":"compare-mesozooplankton-biomass-to-copepod-database","implicit":true,"key":"r3cHBSXEKl"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We use data compiled through the COPEPOD project ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TdRkgmt4O8"},{"type":"cite","url":"https://doi.org/10.