ue":"Connect to cluster","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"t3xFP4hZbo"}],"identifier":"connect-to-cluster","label":"Connect to cluster","html_id":"connect-to-cluster","implicit":true,"key":"a0w0ioXiE0"}],"key":"Flojigd0Du"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"cluster = LocalCluster()\nclient = cluster.get_client()","key":"JbV34b1Qc3"},{"type":"output","id":"31pdVNheGTF47Q0-UnzKd","data":[],"key":"XtfJHOKN1p"}],"key":"x3Z4rBRLMc"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Bring in POP grid utilities","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rSygOaUeFh"}],"identifier":"bring-in-pop-grid-utilities","label":"Bring in POP grid utilities","html_id":"bring-in-pop-grid-utilities","implicit":true,"key":"sriOQ3J5SO"}],"key":"oyxQaWHDwa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds_grid = pop_tools.get_grid('POP_gx1v7')\nlons = ds_grid.TLONG\nlats = ds_grid.TLAT\ndepths = ds_grid.z_t * 0.01","key":"nYfeUQCObW"},{"type":"output","id":"h3mHEisEGlMrOsFFKKfw9","data":[],"key":"bhPDw4InCN"}],"key":"sesqBT2Sns"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Load the data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nzurPkA5xV"}],"identifier":"load-the-data","label":"Load the data","html_id":"load-the-data","implicit":true,"key":"YtIayDL8Wk"}],"key":"c8Nxwo9yVc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"jetstream_url = 'https://js2.jetstream-cloud.org:8001/'\n\ns3 = s3fs.S3FileSystem(anon=True, client_kwargs=dict(endpoint_url=jetstream_url))\n\n# Generate a list of all files in CESM folder\ns3path = 's3://pythia/ocean-bgc/cesm/g.e22.GOMIPECOIAF_JRA-1p4-2018.TL319_g17.4p2z.002branch/ocn/proc/tseries/month_1/*'\nremote_files = s3.glob(s3path)\n\n# Open all files from folder\nfileset = [s3.open(file) for file in remote_files]\n\n# Open with xarray\nds = xr.open_mfdataset(fileset, data_vars=\"minimal\", coords='minimal', compat=\"override\", parallel=True,\n                       drop_variables=[\"transport_components\", \"transport_regions\", 'moc_components'], decode_times=True)\n\nds","key":"rTn9K9LCxE"},{"type":"output","id":"3X1opxHbutTWuq5S5430-","data":[],"key":"LAOq9dEy67"}],"key":"jjSQmN2zgr"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Subsetting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UrLs3U3YEH"}],"identifier":"subsetting","label":"Subsetting","html_id":"subsetting","implicit":true,"key":"cnZzm4zNbK"}],"key":"rUKhciG1l9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"variables =['mesozooC', 'microzooC']","key":"Wo7tns2zGZ"},{"type":"output","id":"eMhH3JagWoSMGi-GQwMPQ","data":[],"key":"eofU41DFa1"}],"key":"ZUTUCXyemT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"keep_vars=['z_t','z_t_150m','dz','time_bound','time','TAREA','TLAT','TLONG'] + variables\nds = ds.drop_vars([v for v in ds.variables if v not in keep_vars])","key":"YW3iDYY3Kf"},{"type":"output","id":"4msMniiuxVopT36J8TsDN","data":[],"key":"jjBtCNntj2"}],"key":"Glw8NgdV6O"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Processing - long-term mean","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"j51yO2GBnO"}],"identifier":"processing-long-term-mean","label":"Processing - long-term mean","html_id":"processing-long-term-mean","implicit":true,"key":"oeg72VoShr"}],"key":"k83XZUQRJM"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pull in the function we defined in the nutrients notebook...","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mXNpCG9Vpu"}],"key":"ZfTgGj1r5Q"}],"key":"PqO12pLUb9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the weights for each year is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")","key":"OC5loVsxxP"},{"type":"output","id":"aRfzFceFL4WHhePT2PCHj","data":[],"key":"kjAwtg3DxI"}],"key":"RxPpNDOsLG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Take the long-term mean of our data set, processing years and months separately\n\nds_annual = year_mean(ds).mean(\"year\")","key":"RLFPIqYntZ"},{"type":"output","id":"E5UDvggczESfVAt7iiAT6","data":[],"key":"So1YaAlko2"}],"key":"Q8wwICVchn"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot mesozooplankton and microzooplankton biomass at the surface","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dHtzVWMeWJ"}],"identifier":"plot-mesozooplankton-and-microzooplankton-biomass-at-the-surface","label":"Plot mesozooplankton and microzooplankton biomass at the surface","html_id":"plot-mesozooplankton-and-microzooplankton-biomass-at-the-surface","implicit":true,"key":"LpSySkWM2c"}],"key":"SQDn9hlsoq"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(8,5))\n\nax = fig.add_subplot(2,1,1, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('microzooC at surface', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats,  ds_annual.microzooC.isel(z_t_150m=0))\npc=ax.pcolormesh(lon, lat, field, cmap='Blues',vmin=0,vmax=2,transform=ccrs.PlateCarree())\ncbar1 = fig.colorbar(pc, ax=ax,extend='max',label='microzooC (mmol m$^{-3}$)')\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\n\nax = fig.add_subplot(2,1,2, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('mesozooC at surface', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats,  ds_annual.mesozooC.isel(z_t_150m=0))\npc=ax.pcolormesh(lon, lat, field, cmap='Oranges',vmin=0,vmax=4,transform=ccrs.PlateCarree())\ncbar1 = fig.colorbar(pc, ax=ax,extend='max',label='mesozooC (mmol m$^{-3}$)')\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)","key":"f1NJCLSNsL"},{"type":"output","id":"whNKka7EoFfsJ3oX8Rtry","data":[],"key":"cyRBlFY9sH"}],"key":"GqDuYrszKB"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare mesozooplankton biomass to COPEPOD database","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RgD8gZEXg0"}],"identifier":"compare-mesozooplankton-biomass-to-copepod-database","label":"Compare mesozooplankton biomass to COPEPOD database","html_id":"compare-mesozooplankton-biomass-to-copepod-database","implicit":true,"key":"Z7q8KVdJVs"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We use data compiled through the COPEPOD project ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jRUVYDAuKE"},{"type":"cite","url":"https://doi.org/10.5194/essd-5-45-2013","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"(Moriarty & O’Brien, 2013)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ZHxsOiloZB"}],"kind":"narrative","label":"Moriarty_2013","identifier":"https://doi.org/10.5194/essd-5-45-2013","enumerator":"1","key":"QWfcKRAi0d"},{"type":"text","value":". This data has been pre-processed, but the raw data is available on the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"WF2Z9qR0qv"},{"type":"link","url":"https://www.st.nmfs.noaa.gov/copepod/about/databases.html","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"COPEPOD website","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"utM4rOMCx5"}],"urlSource":"https://www.st.nmfs.noaa.gov/copepod/about/databases.html","key":"vVjHACq08u"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zBrwAXHcrI"}],"key":"ciQtkjoTyV"}],"key":"B7ArckP5vJ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","dep