ue":"Connect to cluster","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UXRqxLYI9L"}],"identifier":"connect-to-cluster","label":"Connect to cluster","html_id":"connect-to-cluster","implicit":true,"key":"RgS9shKT0Z"}],"key":"mY8rjNxDps"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"cluster = LocalCluster()\nclient = cluster.get_client()","key":"cfPfnvyGb6"},{"type":"output","id":"iIIrjHYEd7qu8jAMHLvid","data":[],"key":"kpfCRzKAgI"}],"key":"CnHx6ZnPwd"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Bring in POP grid utilities","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OQiVEMSWl7"}],"identifier":"bring-in-pop-grid-utilities","label":"Bring in POP grid utilities","html_id":"bring-in-pop-grid-utilities","implicit":true,"key":"iqoUigG5cK"}],"key":"z5Wmr8CQla"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds_grid = pop_tools.get_grid('POP_gx1v7')\nlons = ds_grid.TLONG\nlats = ds_grid.TLAT\ndepths = ds_grid.z_t * 0.01","key":"uoZrrh9gI3"},{"type":"output","id":"A4Vyh6EcXykhP4pc2lzX7","data":[],"key":"q145jeCInQ"}],"key":"AzboE99jk7"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Load the data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"r7MWitsTfB"}],"identifier":"load-the-data","label":"Load the data","html_id":"load-the-data","implicit":true,"key":"zv7pzkYi9g"}],"key":"KXkJsgc4Kc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"jetstream_url = 'https://js2.jetstream-cloud.org:8001/'\n\ns3 = s3fs.S3FileSystem(anon=True, client_kwargs=dict(endpoint_url=jetstream_url))\n\n# Generate a list of all files in CESM folder\ns3path = 's3://pythia/ocean-bgc/cesm/g.e22.GOMIPECOIAF_JRA-1p4-2018.TL319_g17.4p2z.002branch/ocn/proc/tseries/month_1/*'\nremote_files = s3.glob(s3path)\n\n# Open all files from folder\nfileset = [s3.open(file) for file in remote_files]\n\n# Open with xarray\nds = xr.open_mfdataset(fileset, data_vars=\"minimal\", coords='minimal', compat=\"override\", parallel=True,\n                       drop_variables=[\"transport_components\", \"transport_regions\", 'moc_components'], decode_times=True)\n\nds","key":"lawqtFX6Q2"},{"type":"output","id":"w6rdNmQZrMQkxRPNTMPEi","data":[],"key":"oGc3NIDefo"}],"key":"xtVXu9dH2x"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Subsetting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bweDR4a2zc"}],"identifier":"subsetting","label":"Subsetting","html_id":"subsetting","implicit":true,"key":"QxXUiczkIw"}],"key":"fspF3CKGGw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"variables =['mesozooC', 'microzooC']","key":"wmk0Y8pPfS"},{"type":"output","id":"C8obLqa-UR97MI-r3wCS3","data":[],"key":"DPFSxAG0Zl"}],"key":"i6WwoJhNR1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"keep_vars=['z_t','z_t_150m','dz','time_bound','time','TAREA','TLAT','TLONG'] + variables\nds = ds.drop_vars([v for v in ds.variables if v not in keep_vars])","key":"Ki0q40Xnj6"},{"type":"output","id":"0X4TjeFwxTRggin4fwvWI","data":[],"key":"lCVIPYYb5l"}],"key":"E7PB0MvXVi"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Processing - long-term mean","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YeGLJASBGv"}],"identifier":"processing-long-term-mean","label":"Processing - long-term mean","html_id":"processing-long-term-mean","implicit":true,"key":"T8dfoRmmyQ"}],"key":"BgFYimSzAm"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pull in the function we defined in the nutrients notebook...","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jiO3tFL9o9"}],"key":"njJQrtphSV"}],"key":"EHhikUVcPx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the weights for each year is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")","key":"BZ3Imd7lnZ"},{"type":"output","id":"YLn8Mr7SO7l2thH8yJk16","data":[],"key":"e7tJ9lFQRi"}],"key":"PGtUFTZwDJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Take the long-term mean of our data set, processing years and months separately\n\nds_annual = year_mean(ds).mean(\"year\")","key":"BaAXJxEFok"},{"type":"output","id":"_vpj23v4RAwvfcnhviQoe","data":[],"key":"lQqyFXySzJ"}],"key":"UKIrmzQ8HZ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot mesozooplankton and microzooplankton biomass at the surface","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"URL3u58kGQ"}],"identifier":"plot-mesozooplankton-and-microzooplankton-biomass-at-the-surface","label":"Plot mesozooplankton and microzooplankton biomass at the surface","html_id":"plot-mesozooplankton-and-microzooplankton-biomass-at-the-surface","implicit":true,"key":"qNJ3FD55dF"}],"key":"qCTjUlAMRt"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(8,5))\n\nax = fig.add_subplot(2,1,1, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('microzooC at surface', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats,  ds_annual.microzooC.isel(z_t_150m=0))\npc=ax.pcolormesh(lon, lat, field, cmap='Blues',vmin=0,vmax=2,transform=ccrs.PlateCarree())\ncbar1 = fig.colorbar(pc, ax=ax,extend='max',label='microzooC (mmol m$^{-3}$)')\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\n\nax = fig.add_subplot(2,1,2, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('mesozooC at surface', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats,  ds_annual.mesozooC.isel(z_t_150m=0))\npc=ax.pcolormesh(lon, lat, field, cmap='Oranges',vmin=0,vmax=4,transform=ccrs.PlateCarree())\ncbar1 = fig.colorbar(pc, ax=ax,extend='max',label='mesozooC (mmol m$^{-3}$)')\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)","key":"NlWA8c59Ah"},{"type":"output","id":"r273P40PWbdKlf5RcY642","data":[],"key":"rUxE4wUkmq"}],"key":"tIA6kAENEU"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare mesozooplankton biomass to COPEPOD database","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CGp8aMG3qm"}],"identifier":"compare-mesozooplankton-biomass-to-copepod-database","label":"Compare mesozooplankton biomass to COPEPOD database","html_id":"compare-mesozooplankton-biomass-to-copepod-database","implicit":true,"key":"VoHJEbHip8"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We use data compiled through the COPEPOD project ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wzIC5ybEhc"},{"type":"cite","url":"https://doi.org/10.5194/essd-5-45-2013","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"(Moriarty & O’Brien, 2013)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"aXh4jiZwMa"}],"kind":"narrative","label":"Moriarty_2013","identifier":"https://doi.org/10.5194/essd-5-45-2013","enumerator":"1","key":"hgLjg1xMAr"},{"type":"text","value":". This data has been pre-processed, but the raw data is available on the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"thmb32BNWH"},{"type":"link","url":"https://www.st.nmfs.noaa.gov/copepod/about/databases.html","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"COPEPOD website","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XiuUekDG5I"}],"urlSource":"https://www.st.nmfs.noaa.gov/copepod/about/databases.html","key":"WTiYXLhcKY"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"yXmuzjjslA"}],"key":"pbElZHsIdY"}],"key":"rAzZe94ieS"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Read in COPEPOD data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DvaEydDYgy"}],"identifier":"read-in-copepod-data","label":"Read in COPEPOD data","html_id":"read-in-copepod-data","implicit":true,"key":"BNs3y5Bkth"}],"key":"OI51zw0pr0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"copepod_obs_path = 's3://pythia/ocean-bgc/obs/copepod-2012__cmass-m00-qtr.zarr'\n\ncopepod_obs = s3fs.S3Map(root=copepod_obs_path, s3=s3)\n\nds_copepod = xr.open_dataset(copepod_obs, engine=\"zarr\")\n\n### converting grams to moles\nds_copepod['copepod_C']=ds_copepod.copepod_C/12.011","key":"OgBSrsbcVk"},{"type":"output","id":"ELxgdE0lHvBFlMcIOv2hP","data":[],"key":"gh0RzB49K8"}],"key":"QgFrEUImpZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds_copepod","key":"zJ7tlvNVAL"},{"type":"output","id":"o-A1fEnG_ii0f4xsUxJAb","data":[],"key":"tSi8SsAaJe"}],"key":"NcHfTDlEXn"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"n7VsaJ86YH"}],"identifier":"plot","label":"Plot","html_id":"plot","implicit":true,"key":"gXvfpVLOwE"}],"key":"dODKefk8ye"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(12,3))\n\nax = fig.add_subplot(1,2,1, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('COPEPOD dataset', fontsize=12)\npc=ax.pcolormesh(ds_copepod.lon, ds_copepod.lat, ds_copepod.copepod_C, cmap='Reds',vmin=0,vmax=2,transform=ccrs.PlateCarree())\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\nax = fig.add_subplot(1,2,2, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('CESM ${\\it Mesozooplankton}$ biomass', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats, ds_annual.mesozooC.mean(dim='z_t_150m'))\npc=ax.pcolormesh(lon, lat, field, cmap='Reds',vmin=0,vmax=2,transform=ccrs.PlateCarree())\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\nfig.subplots_adjust(right=0.8)\ncbar_ax = fig.add_axes([0.85, 0.15, 0.02, 0.7])\nfig.colorbar(pc, cax=cbar_ax,extend='max', label='top 150m/200m mean (mmol m$^{-3}$)');","key":"simkksZjcq"},{"type":"output","id":"Jfb6QzCsYpm7Po4cwoKC6","data":[],"key":"bFH7BNMThg"}],"key":"ycuz6Vf4A7"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Making monthly climatology maps to compare to observations","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"j7hwidcltC"}],"identifier":"making-monthly-climatology-maps-to-compare-to-observations","label":"Making monthly climatology maps to compare to observations","html_id":"making-monthly-climatology-maps-to-compare-to-observations","implicit":true,"key":"HSKZzGVoxu"}],"key":"pnh7ru6o88"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare to observation-based GLMM (Generalized Linear Mixed Model) of global mesozooplankton biomass climatology","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Ve9B71NvS3"}],"identifier":"compare-to-observation-based-glmm-generalized-linear-mixed-model-of-global-mesozooplankton-biomass-climatology","label":"Compare to observation-based GLMM (Generalized Linear Mixed Model) of global mesozooplankton biomass climatology","html_id":"compare-to-observation-based-glmm-generalized-linear-mixed-model-of-global-mesozooplankton-biomass-climatology","implicit":true,"key":"WfTmhSc2uj"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"This data is from ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"yh8UhiLg1p"},{"type":"cite","url":"https://doi.org/10.1016/j.ecolmodel.2020.109265","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Heneghan et al., 2020","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"rHOp6oozzf"}],"kind":"narrative","label":"Heneghan_2020","identifier":"https://doi.org/10.1016/j.ecolmodel.2020.109265","enumerator":"2","key":"E8CYnBwiNS"},{"type":"text","value":", which includes the COPEPOD dataset we used previously as well as additional observations, with some pre-processing.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"p1shNnfcze"}],"key":"Eod7rbEuWZ"}],"key":"qGUhBWKZIV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mesozoo_obs_path = 'data/obsglmm_zmeso_vint_200m_monthly_climatology.nc'\n\nds_copepod_clim = xr.open_dataset(mesozoo_obs_path)\nds_copepod_clim.zmeso200.attrs['units'] = 'mgC m-2'\n\nmonths = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']","key":"ymRnmQQoM9"},{"type":"output","id":"ZhN2QNaoxtG3Wp1NVsW3-","data":[],"key":"RsGOeC2ryt"}],"key":"QrbFljw50V"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Make our CESM data into a monthly climatology","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vj5jPbSS3D"}],"identifier":"make-our-cesm-data-into-a-monthly-climatology","label":"Make our CESM data into a monthly climatology","html_id":"make-our-cesm-data-into-a-monthly-climatology","implicit":true,"key":"U1ke29YFxd"}],"key":"DoK1BEWkSF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mon_ds = ds.copy()\nmon_ds = ds.groupby('time.month').mean('time')","key":"GM4TEalvEA"},{"type":"output","id":"8G34jXUXTJ1dkG_ZMU41y","data":[],"key":"cfPbP6UlOW"}],"key":"oHAf0j4HLn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"### depth integrate and convert model to mg C/m2\nmon_ds['mesozooC_zint'] = ((mon_ds.mesozooC) * 10.).sum(dim='z_t_150m') #in mmol/m2\nmon_ds['mesozooC_zint'] = mon_ds['mesozooC_zint'] * 12.011 #convert to mgC/m2\nmon_ds['mesozooC_zint'].attrs['units'] = 'mgC m-2'","key":"iHAttKt2jb"},{"type":"output","id":"UNzKAc2lx4-8XEufVVu3s","data":[],"key":"nTVA87yjeK"}],"key":"YtL0RfXwl1"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZQEObF1FV1"}],"identifier":"plot","label":"Plot","html_id":"plot-1","implicit":true,"key":"OqC0QaI9NE"}],"key":"dtGYrUa5oL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(5,18))\n\nfor row in np.arange(1,13):\n    \n    ts=row-1\n    \n    plot = row*2 - 1\n    ax = fig.add_subplot(12,2,plot, projection=ccrs.Robinson(central_longitude=305.0))\n    ax.set_title(months[ts]+' obs', fontsize=12)\n    pc=ax.pcolormesh(ds_copepod_clim.Lon, ds_copepod_clim.Lat, ds_copepod_clim.zmeso200.isel(month=ts), \n                     cmap='Reds',vmin=0,vmax=4000,transform=ccrs.PlateCarree())\n    land = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\n    ax.add_feature(land)\n    \n    plot = row*2\n    ax = fig.add_subplot(12,2,plot, projection=ccrs.Robinson(central_longitude=305.0))\n    ax.set_title(months[ts]+' CESM', fontsize=12)\n    tmp = mon_ds.mesozooC_zint.isel(month=ts)\n    lon, lat, field = adjust_pop_grid(lons, lats,  tmp)\n    pc=ax.pcolormesh(lon, lat, field, cmap='Reds',vmin=0,vmax=4000,transform=ccrs.PlateCarree())\n    land = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\n    ax.add_feature(land)\n\ncbar_ax = fig.add_axes([0.92, 0.15, 0.03, 0.7])\nfig.colorbar(pc, cax=cbar_ax,extend='max', label='Depth-integrated copepod biomass (mg m$^{-2}$)');","key":"HGEl5i23Nh"},{"type":"output","id":"eHR31Orw-KpWfU0yny3hS","data":[],"key":"Loh4KqQmCV"}],"key":"pkwvYT3YtS"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"And close the Dask cluster we spun up at the beginning.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VlQtlY1JJZ"}],"key":"WFoaEHVn7a"}],"key":"AcckARFl61"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"cluster.close()","key":"iTmN4WtLp5"},{"type":"output","id":"1w60M228huojGFeL_Ck5B","data":[],"key":"mwqggS3OA2"}],"key":"wVKWyHpLNn"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Vg0VSTJaTl"}],"key":"vn2gya16BE"},{"type":"block","kind":"notebook-content","data":{"jp-MarkdownHeadingCollapsed":true},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position"