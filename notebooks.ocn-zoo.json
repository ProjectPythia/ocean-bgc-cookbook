root=copepod_obs_path, s3=s3)\n\nds_copepod = xr.open_dataset(copepod_obs, engine=\"zarr\")\n\n### converting grams to moles\nds_copepod['copepod_C']=ds_copepod.copepod_C/12.011","key":"qnyepwx2nT"},{"type":"outputs","id":"E3jurWrY-yEPRgr_POea3","children":[],"key":"FO8BFTG7Eu"}],"identifier":"12ebf98e-ecc4-4e7a-a41d-0acb21a21e3e","html_id":"12ebf98e-ecc4-4e7a-a41d-0acb21a21e3e","key":"zaTUD1rLCw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds_copepod","key":"gNSewjxATG"},{"type":"outputs","id":"tIzIXh2ncCohl2MSO53UP","children":[],"key":"d1MjWmuzLj"}],"identifier":"0b6471bf-0d65-4cfb-9ce9-85cfcbeb3934","html_id":"0b6471bf-0d65-4cfb-9ce9-85cfcbeb3934","key":"aiJwv2UKSA"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"AaSxlMaYgS"}],"identifier":"plot","label":"Plot","html_id":"plot","implicit":true,"key":"yGEKkPtOx9"}],"identifier":"3304c95d-9e96-403f-ac97-5450d2e8b0ab","html_id":"3304c95d-9e96-403f-ac97-5450d2e8b0ab","key":"VD8KdPIjCN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(12,3))\n\nax = fig.add_subplot(1,2,1, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('COPEPOD dataset', fontsize=12)\npc=ax.pcolormesh(ds_copepod.lon, ds_copepod.lat, ds_copepod.copepod_C, cmap='Reds',vmin=0,vmax=2,transform=ccrs.PlateCarree())\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\nax = fig.add_subplot(1,2,2, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('CESM ${\\it Mesozooplankton}$ biomass', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats, ds_annual.mesozooC.mean(dim='z_t_150m'))\npc=ax.pcolormesh(lon, lat, field, cmap='Reds',vmin=0,vmax=2,transform=ccrs.PlateCarree())\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\nfig.subplots_adjust(right=0.8)\ncbar_ax = fig.add_axes([0.85, 0.15, 0.02, 0.7])\nfig.colorbar(pc, cax=cbar_ax,extend='max', label='top 150m/200m mean (mmol m$^{-3}$)');","key":"vMsiRdbJBU"},{"type":"outputs","id":"3PCg89S2_vnORWDLCB-7B","children":[],"key":"dpdXouiixV"}],"identifier":"8f2f80dd-b738-437c-8ff7-1c6dc7423b74","html_id":"8f2f80dd-b738-437c-8ff7-1c6dc7423b74","key":"o8FFiZvuBI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Making monthly climatology maps to compare to observations","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UMFjXb2Tzc"}],"identifier":"making-monthly-climatology-maps-to-compare-to-observations","label":"Making monthly climatology maps to compare to observations","html_id":"making-monthly-climatology-maps-to-compare-to-observations","implicit":true,"key":"ek4FIOZ1S8"}],"identifier":"0a4c0e5d-aaa7-446a-81e8-c1ae3f60d94e","html_id":"0a4c0e5d-aaa7-446a-81e8-c1ae3f60d94e","key":"lDEhmVsZXW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare to observation-based GLMM (Generalized Linear Mixed Model) of global mesozooplankton biomass climatology","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mztRGgXaeh"}],"identifier":"compare-to-observation-based-glmm-generalized-linear-mixed-model-of-global-mesozooplankton-biomass-climatology","label":"Compare to observation-based GLMM (Generalized Linear Mixed Model) of global mesozooplankton biomass climatology","html_id":"compare-to-observation-based-glmm-generalized-linear-mixed-model-of-global-mesozooplankton-biomass-climatology","implicit":true,"key":"csvj3hClkg"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"This data is from ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"EcEwPmS5Er"},{"type":"cite","url":"https://doi.org/10.1016/j.ecolmodel.2020.109265","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Heneghan et al., 2020","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Q5kms3rbsn"}],"kind":"narrative","label":"Heneghan_2020","identifier":"https://doi.org/10.1016/j.ecolmodel.2020.109265","enumerator":"2","key":"pljr2wovBT"},{"type":"text","value":", which includes the COPEPOD dataset we used previously as well as additional observations, with some pre-processing.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"SBHQubP7Cg"}],"key":"HBuISCyc99"}],"identifier":"5085ee6d-457c-46dd-9beb-5b8f08d46473","html_id":"5085ee6d-457c-46dd-9beb-5b8f08d46473","key":"qnyk4IkWGR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mesozoo_obs_path = 'data/obsglmm_zmeso_vint_200m_monthly_climatology.nc'\n\nds_copepod_clim = xr.open_dataset(mesozoo_obs_path)\nds_copepod_clim.zmeso200.attrs['units'] = 'mgC m-2'\n\nmonths = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']","key":"MUriTnfOFu"},{"type":"outputs","id":"NxeDeTigJvHz7oYXOlzRR","children":[],"key":"PGGZUTHa2X"}],"identifier":"4ce3182e-deaa-4594-bb84-2eb8f7874fb8","html_id":"4ce3182e-deaa-4594-bb84-2eb8f7874fb8","key":"UqJsD7TPmX"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Make our CESM data into a monthly climatology","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"COmMKlEYeu"}],"identifier":"make-our-cesm-data-into-a-monthly-climatology","label":"Make our CESM data into a monthly climatology","html_id":"make-our-cesm-data-into-a-monthly-climatology","implicit":true,"key":"Ixdzk3E3ZZ"}],"identifier":"a8982df2-5cb7-47e1-a48f-8f6041e9c0d3","html_id":"a8982df2-5cb7-47e1-a48f-8f6041e9c0d3","key":"j2sr7sRiL4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mon_ds = ds.copy()\nmon_ds = ds.groupby('time.month').mean('time')","key":"akvrZTcBsy"},{"type":"outputs","id":"NH1X34gMUnkWDh292R7SO","children":[],"key":"GSN5BznoRK"}],"identifier":"950e227c-396c-4217-86d0-d31b0e6275e8","html_id":"950e227c-396c-4217-86d0-d31b0e6275e8","key":"AnSk3HZ24V"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"### depth integrate and convert model to mg C/m2\nmon_ds['mesozooC_zint'] = ((mon_ds.mesozooC) * 10.).sum(dim='z_t_150m') #in mmol/m2\nmon_ds['mesozooC_zint'] = mon_ds['mesozooC_zint'] * 12.011 #convert to mgC/m2\nmon_ds['mesozooC_zint'].attrs['units'] = 'mgC m-2'","key":"BJw5HCXJNo"},{"type":"outputs","id":"vWZ_6V6mUCikicqOqwM99","children":[],"key":"R2k84EpEkO"}],"identifier":"94bda07d-0f2d-4940-9e7a-3fecb1d9aefe","html_id":"94bda07d-0f2d-4940-9e7a-3fecb1d9aefe","key":"VwjOP8Zzz6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"peMI6WCRIJ"}],"identifier":"plot","label":"Plot","html_id":"plot-1","implicit":true,"key":"qvfGuzunHk"}],"identifier":"9b1c6f93-4ebe-482b-8e50-0bd268881263","html_id":"9b1c6f93-4ebe-482b-8e50-0bd268881263","key":"Pw8EqEtuHg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(5,18))\n\nfor row in np.arange(1,13):\n    \n    ts=row-1\n    \n    plot = row*2 - 1\n    ax = fig.add_subplot(12,2,plot, projection=ccrs.Robinson(central_longitude=305.0))\n    ax.set_title(months[ts]+' obs', fontsize=12)\n    pc=ax.pcolormesh(ds_copepod_clim.Lon, ds_copepod_clim.Lat, ds_copepod_clim.zmeso200.isel(month=ts), \n                     cmap='Reds',vmin=0,vmax=4000,transform=ccrs.PlateCarree())\n    land = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\n    ax.add_feature(land)\n    \n    plot = row*2\n    ax = fig.add_subplot(12,2,plot, projection=ccrs.Robinson(central_longitude=305.0))\n    ax.set_title(months[ts]+' CESM', fontsize=12)\n    tmp = mon_ds.mesozooC_zint.isel(month=ts)\n    lon, lat, field = adjust_pop_grid(lons, lats,  tmp)\n    pc=ax.pcolormesh(lon, lat, field, cmap='Reds',vmin=0,vmax=4000,transform=ccrs.PlateCarree())\n    land = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\n    ax.add_feature(land)\n\ncbar_ax = fig.add_axes([0.92, 0.15, 0.03, 0.7])\nfig.colorbar(pc, cax=cbar_ax,extend='max', label='Depth-integrated copepod biomass (mg m$^{-2}$)');","key":"cfjiDZrygx"},{"type":"outputs","id":"sq-RTiCy1EGNnla9u-cXo","children":[],"key":"ple6Xx7z5B"}],"identifier":"6e28f6a9-7db6-4db0-860b-e64a6058911f","html_id":"6e28f6a9-7db6-4db0-860b-e64a6058911f","key":"zU1ZMHUIuE"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"And close the Dask cluster we spun up at the beginning.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vo6imjarh3"}],"key":"MUbvIbEGQp"}],"identifier":"03fbe3b5-033d-4f90-a193-e86c16910878","html_i