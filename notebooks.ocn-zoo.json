code","lang":"python","executable":true,"value":"jetstream_url = 'https://js2.jetstream-cloud.org:8001/'\n\ns3 = s3fs.S3FileSystem(anon=True, client_kwargs=dict(endpoint_url=jetstream_url))\n\n# Generate a list of all files in CESM folder\ns3path = 's3://pythia/ocean-bgc/cesm/g.e22.GOMIPECOIAF_JRA-1p4-2018.TL319_g17.4p2z.002branch/ocn/proc/tseries/month_1/*'\nremote_files = s3.glob(s3path)\ns3.invalidate_cache()\n\n# Open all files from folder\nfileset = [s3.open(file) for file in remote_files]\n\n# Open with xarray\nds = xr.open_mfdataset(fileset, data_vars=\"minimal\", coords='minimal', compat=\"override\", parallel=True,\n                       drop_variables=[\"transport_components\", \"transport_regions\", 'moc_components'], decode_times=True)\n\nds","key":"wRFIt16Pad"},{"type":"outputs","id":"4jmYyslT1x-8WYSnwb-oW","children":[],"key":"EAA90Idsxi"}],"identifier":"37fb64e2-f0a3-4951-a480-7092b4ab04cd","html_id":"37fb64e2-f0a3-4951-a480-7092b4ab04cd","key":"fEKaH7bB7g"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Subsetting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TmnGoyeUAZ"}],"identifier":"subsetting","label":"Subsetting","html_id":"subsetting","implicit":true,"key":"LEwrDks8b2"}],"identifier":"50be6930-f48e-4d7a-9828-7b2766bf9bf2","html_id":"50be6930-f48e-4d7a-9828-7b2766bf9bf2","key":"pG1Bhrtwfc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"variables =['mesozooC', 'microzooC']","key":"G2pkXHpVuw"},{"type":"outputs","id":"Hv2fOT3CQm1KnwHG-z8Q2","children":[],"key":"K33ijgumEb"}],"identifier":"ea5e9150-4e80-45a2-a5b6-a8b6a474cf72","html_id":"ea5e9150-4e80-45a2-a5b6-a8b6a474cf72","key":"CAkBK7qGYp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"keep_vars=['z_t','z_t_150m','dz','time_bound','time','TAREA','TLAT','TLONG'] + variables\nds = ds.drop_vars([v for v in ds.variables if v not in keep_vars])","key":"zVa3OgfRHY"},{"type":"outputs","id":"i3PvemI5_x52A4REg34KV","children":[],"key":"Sdu0nRW3J8"}],"identifier":"a63a74ea-ac56-4034-aeaa-f648909fe59a","html_id":"a63a74ea-ac56-4034-aeaa-f648909fe59a","key":"gO21lD7u7Z"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Processing - long-term mean","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FReqxO5O8U"}],"identifier":"processing-long-term-mean","label":"Processing - long-term mean","html_id":"processing-long-term-mean","implicit":true,"key":"xmz5dEwSRA"}],"identifier":"febdf9c0-a98c-49fa-b224-bbe085895384","html_id":"febdf9c0-a98c-49fa-b224-bbe085895384","key":"yWewuCNunh"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pull in the function we defined in the nutrients notebook...","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qOqHn0yZ0h"}],"key":"lRem3bXoRm"}],"identifier":"65b8fc08-c579-4353-bacf-af1b4f11d33d","html_id":"65b8fc08-c579-4353-bacf-af1b4f11d33d","key":"tMOaUHWEpr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the weights for each year is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")","key":"vx2sctvBI0"},{"type":"outputs","id":"ZNEP2qXkAKjXSYtmcQ94L","children":[],"key":"tUgR1lFcs6"}],"identifier":"5ee51015-79b5-4953-924f-ff788cc69d99","html_id":"5ee51015-79b5-4953-924f-ff788cc69d99","key":"L7EZA8R8mk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Take the long-term mean of our data set, processing years and months separately\n\nds_annual = year_mean(ds).mean(\"year\")","key":"Shv9YgYqmD"},{"type":"outputs","id":"lkviPr-nr0ITRTBOJLKaF","children":[],"key":"V8iqbmEBVj"}],"identifier":"ec7887be-7aea-47c8-be19-4bc681d2b71a","html_id":"ec7887be-7aea-47c8-be19-4bc681d2b71a","key":"RGcj6ArXxs"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot mesozooplankton and microzooplankton biomass at the surface","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tLtU6ojuLx"}],"identifier":"plot-mesozooplankton-and-microzooplankton-biomass-at-the-surface","label":"Plot mesozooplankton and microzooplankton biomass at the surface","html_id":"plot-mesozooplankton-and-microzooplankton-biomass-at-the-surface","implicit":true,"key":"R8LMovbuu1"}],"identifier":"d18b05d1-034e-4671-b7c1-055dfb4c7828","html_id":"d18b05d1-034e-4671-b7c1-055dfb4c7828","key":"keo1V9JMx2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(8,5))\n\nax = fig.add_subplot(2,1,1, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('microzooC at surface', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats,  ds_annual.microzooC.isel(z_t_150m=0))\npc=ax.pcolormesh(lon, lat, field, cmap='Blues',vmin=0,vmax=2,transform=ccrs.PlateCarree())\ncbar1 = fig.colorbar(pc, ax=ax,extend='max',label='microzooC (mmol m$^{-3}$)')\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\n\nax = fig.add_subplot(2,1,2, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('mesozooC at surface', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats,  ds_annual.mesozooC.isel(z_t_150m=0))\npc=ax.pcolormesh(lon, lat, field, cmap='Oranges',vmin=0,vmax=4,transform=ccrs.PlateCarree())\ncbar1 = fig.colorbar(pc, ax=ax,extend='max',label='mesozooC (mmol m$^{-3}$)')\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)","key":"jcNFctB66s"},{"type":"outputs","id":"8hcXhGHwkfkLuUWdOxq0C","children":[],"key":"P43Yf6U8i9"}],"identifier":"bff8e04c-c929-4159-8c04-208cad7285d6","html_id":"bff8e04c-c929-4159-8c04-208cad7285d6","key":"iNPtN4lBFU"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare mesozooplankton biomass to COPEPOD database","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cf7KK9fKZ6"}],"identifier":"compare-mesozooplankton-biomass-to-copepod-database","label":"Compare mesozooplankton biomass to COPEPOD database","html_id":"compare-mesozooplankton-biomass-to-copepod-database","implicit":true,"key":"k24rqT1Hrd"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We use data compiled through the COPEPOD project ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"mtLYYYD6zq"},{"type":"cite","url":"https://doi.org/10.5194/essd-5-45-2013","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"(Moriarty & O’Brien, 2013)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xlitgXfRYt"}],"kind":"narrative","label":"Moriarty_2013","identifier":"https://doi.org/10.5194/essd-5-45-2013","enumerator":"1","key":"C2k0PQNhUV"},{"type":"text","value":". This data has been pre-processed, but the raw data is available on the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"KP9lSjzfV1"},{"type":"link","url":"https://www.st.nmfs.noaa.gov/copepod/about/databases.html","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"COPEPOD website","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"QfpOm1ArQO"}],"urlSource":"https://www.st.nmfs.noaa.gov/copepod/about/databases.html","key":"RBTsbOzO3R"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ld1w3zNskl"}],"key":"RQ3Xv1U1G2"}],"identifier":"745e6a54-9175-48c4-8a9b-f52c2345b593","html_id":"745e6a54-9175-48c4-8a9b-f52c2345b593","key":"dYx9xwVhmT"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Read in COPEPOD data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oXWxaO1pXK"}],"identifier":"read-in-copepod-data","label":"Read in COPEPOD data","html_id":"read-in-copepod-data","implicit":true,"key":"WspAAr9grq"}],"identifier":"b59c9e72-4b8f-4e98-8724-a206416eacf0","html_id":"b59c9e72-4b8f-4e98-8724-a206416eacf0","key":"eVX8I7n72y"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"copepod_obs_path = 's3://pythia/ocean-bgc/obs/copepod-2012__cmass-m00-qtr.zarr'\n\ncopepod_obs = s3fs.S3Map(root=copepod_obs_path, s3=s3)\n\nds_copepod = xr.open_dataset(copepod_obs, engine=\"zarr\")\n\n### converting grams to moles\nds_copepod['copepod_C']=ds_copepod.copepod_C/12.011","key":"a53JyGloe9"},{"type":"outputs","id":"w6LjWuWLb6voWZwlqx1r-","children":[],"key":"LoLjb2i7K3"}],"identifier":"12ebf98e-ecc4-4e7a-a41d-0acb21a21e3e","html_id":"12ebf98e-ecc4-4e7a-a41d-0acb21a21e3e","key":"ELbe43NdO8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds_copepod","key":"gyji9cAEsP"},{"type":"outputs","id":"LG3xVv0jrzzJ2czy8jaau","children":[],"key":"gM8CfmP4d1"}],"identifier":"0b6471bf-0d65-4cfb-9ce9-85cfcbeb3934","html_id":"0b6471bf-0d65-4cfb-9ce9-85cfcbeb3934","key":"bH1qGBKnYY"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WNk5Nq5jc8"}],"identifier":"plot","label":"Plot","html_id":"plot","implicit":true,"key":"DlAwWqm5Ap"}],"identifier":"3304c95d-9e96-403f-ac97-5450d2e8b0ab","html_id":"3304c95d-9e96-403f-ac97-5450d2e8b0ab","key":"BVUlMeGA7S"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(12,3))\n\nax = fig.add_subplot(1,2,1, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('COPEPOD dataset', fontsize=12)\npc=ax.pcolormesh(ds_copepod.lon, ds_copepod.lat, ds_copepod.copepod_C, cmap='Reds',vmin=0,vmax=2,transform=ccrs.PlateCarree())\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\nax = fig.add_subplot(1,2,2, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('CESM ${\\it Mesozooplankton}$ biomass', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats, ds_annual.mesozooC.mean(dim='z_t_150m'))\npc=ax.pcolormesh(lon, lat, field, cmap='Reds',vmin=0,vmax=2,transform=ccrs.PlateCarree())\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\nfig.subplots_adjust(right=0.8)\ncbar_ax = fig.add_axes([0.85, 0.15, 0.02, 0.7])\nfig.colorbar(pc, cax=cbar_ax,extend='max', label='top 150m/200m mean (mmol m$^{-3}$)');","key":"wZwv87fj6o"},{"type":"outputs","id":"PLnTUHYrB2pVw5pihWbo6","children":[],"key":"OBhVqotho4"}],"identifier":"8f2f80dd-b738-437c-8ff7-1c6dc7423b74","html_id":"8f2f80dd-b738-437c-8ff7-1c6dc7423b74","key":"LLp93HyZxi"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Making monthly climatology maps to compare to observations","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bVWzl7OUJ3"}],"identifier":"making-monthly-climatology-maps-to-compare-to-observations","label":"Making monthly climatology maps to compare to observations","html_id":"making-monthly-climatology-maps-to-compare-to-observations","implicit":true,"key":"DQLbqMDkeH"}],"identifier":"0a4c0e5d-aaa7-446a-81e8-c1ae3f60d94e","html_id":"0a4c0e5d-aaa7-446a-81e8-c1ae3f60d94e","key":"DAREcMN5eP"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare to observation-based GLMM (Generalized Linear Mixed Model) of global mesozooplankton biomass climatology","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fckRlQD0IJ"}],"identifier":"compare-to-observation-based-glmm-generalized-linear-mixed-model-of-global-mesozooplankton-biomass-climatology","label":"Compare to observation-based GLMM (Generalized Linear Mixed Model) of global mesozooplankton biomass climatology","html_id":"compare-to-observation-based-glmm-generalized-linear-mixed-model-of-global-mesozooplankton-biomass-climatology","implicit":true,"key":"aU7dwmIg4s"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"This data is from ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"OEo4qjeTrA"},{"type":"cite","url":"https://doi.org/10.1016/j.ecolmodel.2020.109265","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Heneghan et al., 2020","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ZRa7AnJcKy"}],"kind":"narrative","label":"Heneghan_2020","identifier":"https://doi.org/10.1016/j.ecolmodel.2020.109265","enumerator":"2","key":"QOgZEHBt8C"},{"type":"text","value":", which includes the COPEPOD dataset we used previously as well as additional observations, with some pre-processing.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"vD9vN87oQK"}],"key":"qsWRkCWYx0"}],"identifier":"5085ee6d-457c-46dd-9beb-5b8f08d46473","html_id":"5085ee6d-457c-46dd-9beb-5b8f08d46473","key":"SibGEqwWWF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mesozoo_obs_path = 'data/obsglmm_zmeso_vint_200m_monthly_climatology.nc'\n\nds_copepod_clim = xr.open_dataset(mesozoo_obs_path)\nds_copepod_clim.zmeso200.attrs['units'] = 'mgC m-2'\n\nmonths = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']","key":"AmXlo7hAz6"},{"type":"outputs","id":"h7a4RnRbRQOUXz_oXkxGl","children":[],"key":"UEKU3VjyNI"}],"identifier":"4ce3182e-deaa-4594-bb84-2eb8f7874fb8","html_id":"4ce3182e-deaa-4594-bb84-2eb8f7874fb8","key":"z7qKvBMlFP"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Make our CESM data into a monthly climatology","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QqHaJOqA5j"}],"identifier":"make-our-cesm-data-into-a-monthly-climatology","label":"Make our CESM data into a monthly climatology","html_id":"make-our-cesm-data-into-a-monthly-climatology","implicit":true,"key":"oh4CjaypWM"}],"identifier":"a8982df2-5cb7-47e1-a48f-8f6041e9c0d3","html_id":"a8982df2-5cb7-47e1-a48f-8f6041e9c0d3","key":"eLSlp3QU76"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mon_ds = ds.copy()\nmon_ds = ds.groupby('time.month').mean('time')","key":"KSyeBFL6VK"},{"type":"outputs","id":"Cxp05KnR5r_AgoT4Fi0YI","children":[],"key":"lN0AFfPlPc"}],"identifier":"950e227c-396c-4217-86d0-d31b0e6275e8","html_id":"950e227c-396c-4217-86d0-d31b0e6275e8","key":"zewPCd1HzQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"### depth integrate and convert model to mg C/m2\nmon_ds['mesozooC_zint'] = ((mon_ds.mesozooC) * 10.).sum(dim='z_t_150m') #in mmol/m2\nmon_ds['mesozooC_zint'] = mon_ds['mesozooC_zint'] * 12.011 #convert to mgC/m2\nmon_ds['mesozooC_zint'].attrs['units'] = 'mgC m-2'","key":"aPi2InPw70"},{"type":"outputs","id":"feGKjopQqW-0WP7aPwh77","children":[],"key":"kgxGOseyr8"}],"identifier":"94bda07d-0f2d-4940-9e7a-3fecb1d9aefe","html_id":"94bda07d-0f2d-4940-9e7a-3fecb1d9aefe","key":"t16hvWHBrc"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ahF2Cz4uVO"}],"identifier":"plot","label":"Plot","html_id":"plot-1","implicit":true,"key":"iHCXwqmLzf"}],"identifier":"9b1c6f93-4ebe-482b-8e50-0bd268881263","html_id":"9b1c6f93-4ebe-482b-8e50-0bd268881263","key":"wbLFJOXFun"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(5,18))\n\nfor row in np.arange(1,13):\n    \n    ts=row-1\n    \n    plot = row*2 - 1\n    ax = fig.add_subplot(12,2,plot, projection=ccrs.Robinson(central_longitude=305.0))\n    ax.set_title(months[ts]+' obs', fontsize=12)\n    pc=ax.pcolormesh(ds_copepod_clim.Lon, ds_copepod_clim.Lat, ds_copepod_clim.zmeso200.isel(month=ts), \n                     cmap='Reds',vmin=0,vmax=4000,transform=ccrs.PlateCarree())\n    land = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\n    ax.add_feature(land)\n    \n    plot = row*2\n    ax = fig.add_subplot(12,2,plot, projection=ccrs.Robinson(central_longitude=305.0))\n    ax.set_title(months[ts]+' CESM', fontsize=12)\n    tmp = mon_ds.mesozooC_zint.isel(month=ts)\n    lon, lat, field = adjust_pop_grid(lons, lats,  tmp)\n    pc=ax.pcolormesh(lon, lat, field, cmap='Reds',vmin=0,vmax=4000,transform=ccrs.PlateCarree())\n    land = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\n    ax.add_feature(land)\n\ncbar_ax = fig.add_axes([0.92, 0.15, 0.03, 0.7])\nfig.colorbar(pc, cax=cbar_ax,extend='max', label='Depth-integrated copepod biomass (mg m$^{-2}$)');","key":"ecYkunGLVJ"},{"type":"outputs","id":"rlg_dYwH6eiCqsYDBfFW-","children":[],"key":"CI5dCIp9NQ"}],"identifier":"6e28f6a9-7db6-4db0-860b-e64a6058911f","html_id":"6e28f6a9-7db6-4db0-860b-e64a6058911f","key":"xKzbEMBPry"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"And close the Dask cluster we spun up at the beginning.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yf5Gc10igc"}],"key":"I5N6nD1Y0b"}],"identifier":"03fbe3b5-033d-4f90-a193-e86c16910878","html_id":"03