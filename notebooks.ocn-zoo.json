e":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"variables =['mesozooC', 'microzooC']","key":"tSBMoCITax"},{"type":"outputs","id":"Bt0wTpiVbh9XPr2RCsjuo","children":[],"key":"VpN1Up7JK7"}],"key":"gxYDO9a8tJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"keep_vars=['z_t','z_t_150m','dz','time_bound','time','TAREA','TLAT','TLONG'] + variables\nds = ds.drop_vars([v for v in ds.variables if v not in keep_vars])","key":"CQ5zyc21mo"},{"type":"outputs","id":"sMG--J3KLgSII1Ld1Fpgv","children":[],"key":"DtwlfRmrKt"}],"key":"O1lIYZj8JI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Processing - long-term mean","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nXjYRFXRFW"}],"identifier":"processing-long-term-mean","label":"Processing - long-term mean","html_id":"processing-long-term-mean","implicit":true,"key":"lrxgjzhqfs"}],"key":"snv3xvDdOo"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pull in the function we defined in the nutrients notebook...","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cPi1WmVeWE"}],"key":"hJbGPhos81"}],"key":"jOc9VQ4Tfy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the weights for each year is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")","key":"u4rt9tY52f"},{"type":"outputs","id":"DJj9D_b17aEvj_ssoad7W","children":[],"key":"YpKqMjkhnl"}],"key":"yOat7vXu2w"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Take the long-term mean of our data set, processing years and months separately\n\nds_annual = year_mean(ds).mean(\"year\")","key":"T3DnuQcH3N"},{"type":"outputs","id":"UoEnMGwuYXO0NtF51ySqd","children":[],"key":"KUnbsixn7y"}],"key":"EowtI90SvT"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot mesozooplankton and microzooplankton biomass at the surface","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gpSAj0mE1m"}],"identifier":"plot-mesozooplankton-and-microzooplankton-biomass-at-the-surface","label":"Plot mesozooplankton and microzooplankton biomass at the surface","html_id":"plot-mesozooplankton-and-microzooplankton-biomass-at-the-surface","implicit":true,"key":"nfmD68rpAX"}],"key":"BRV7qauJJt"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(8,5))\n\nax = fig.add_subplot(2,1,1, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('microzooC at surface', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats,  ds_annual.microzooC.isel(z_t_150m=0))\npc=ax.pcolormesh(lon, lat, field, cmap='Blues',vmin=0,vmax=2,transform=ccrs.PlateCarree())\ncbar1 = fig.colorbar(pc, ax=ax,extend='max',label='microzooC (mmol m$^{-3}$)')\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\n\nax = fig.add_subplot(2,1,2, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('mesozooC at surface', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats,  ds_annual.mesozooC.isel(z_t_150m=0))\npc=ax.pcolormesh(lon, lat, field, cmap='Oranges',vmin=0,vmax=4,transform=ccrs.PlateCarree())\ncbar1 = fig.colorbar(pc, ax=ax,extend='max',label='mesozooC (mmol m$^{-3}$)')\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)","key":"hZLvvBL0OO"},{"type":"outputs","id":"vT3JV_d38qnZ3H3y1PCEu","children":[],"key":"oM9OpqjTW5"}],"key":"GuxZlRlc0m"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare mesozooplankton biomass to COPEPOD database","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ccQaCoMVjQ"}],"identifier":"compare-mesozooplankton-biomass-to-copepod-database","label":"Compare mesozooplankton biomass to COPEPOD database","html_id":"compare-mesozooplankton-biomass-to-copepod-database","implicit":true,"key":"PzOdQbRYNh"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We use data compiled through the COPEPOD project ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fA4BPXyT18"},{"type":"cite","url":"https://doi.org/10.5194/essd-5-45-2013","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"(Moriarty & O’Brien, 2013)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PpiOjCVQ2A"}],"kind":"narrative","label":"Moriarty_2013","identifier":"https://doi.org/10.5194/