key":"tYndNm55cV"}],"identifier":"subsetting","label":"Subsetting","html_id":"subsetting","implicit":true,"key":"lYFCgnousU"}],"key":"J8Eh6Cjmct"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"variables =['mesozooC', 'microzooC']","key":"MHiNV8D2B6"},{"type":"outputs","id":"dkWTvfudEGiOtL2yLuebm","children":[],"key":"shqaKcPBgy"}],"key":"Lw2x0Ai7vT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"keep_vars=['z_t','z_t_150m','dz','time_bound','time','TAREA','TLAT','TLONG'] + variables\nds = ds.drop_vars([v for v in ds.variables if v not in keep_vars])","key":"hxWAtzPIBt"},{"type":"outputs","id":"DO8jH37NRo1zehhxBanc4","children":[],"key":"H1Gqp3vVXA"}],"key":"FqXZtWhUUD"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Processing - long-term mean","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Q1tWNFsgya"}],"identifier":"processing-long-term-mean","label":"Processing - long-term mean","html_id":"processing-long-term-mean","implicit":true,"key":"VBXKpoU1S6"}],"key":"JNVkYesNpS"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pull in the function we defined in the nutrients notebook...","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ROXBHNd3AC"}],"key":"sJbpEa3HGo"}],"key":"wNQQ249jes"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the weights for each year is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")","key":"iAEJ5ReZQ1"},{"type":"outputs","id":"1w7Lb6wfeLzUfd3-MabYd","children":[],"key":"BmY1RbusGO"}],"key":"FCPxNDFNh8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Take the long-term mean of our data set, processing years and months separately\n\nds_annual = year_mean(ds).mean(\"year\")","key":"eUh7yHDFHH"},{"type":"outputs","id":"zEDlqqobAJYpZXyyJwsG5","children":[],"key":"BT5FQBFTnC"}],"key":"dttKP10evE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot mesozooplankton and microzooplankton biomass at the surface","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wI1EWaVOS6"}],"identifier":"plot-mesozooplankton-and-microzooplankton-biomass-at-the-surface","label":"Plot mesozooplankton and microzooplankton biomass at the surface","html_id":"plot-mesozooplankton-and-microzooplankton-biomass-at-the-surface","implicit":true,"key":"ko482fcuCQ"}],"key":"IUsxIjeUbn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(8,5))\n\nax = fig.add_subplot(2,1,1, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('microzooC at surface', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats,  ds_annual.microzooC.isel(z_t_150m=0))\npc=ax.pcolormesh(lon, lat, field, cmap='Blues',vmin=0,vmax=2,transform=ccrs.PlateCarree())\ncbar1 = fig.colorbar(pc, ax=ax,extend='max',label='microzooC (mmol m$^{-3}$)')\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\n\nax = fig.add_subplot(2,1,2, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('mesozooC at surface', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats,  ds_annual.mesozooC.isel(z_t_150m=0))\npc=ax.pcolormesh(lon, lat, field, cmap='Oranges',vmin=0,vmax=4,transform=ccrs.PlateCarree())\ncbar1 = fig.colorbar(pc, ax=ax,extend='max',label='mesozooC (mmol m$^{-3}$)')\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)","key":"kI7v6B0C6i"},{"type":"outputs","id":"4iLJTdATkcnezLgsqvOjR","children":[],"key":"Z8YM0r15ux"}],"key":"HyNVEc6vQx"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare mesozooplankton biomass to COPEPOD database","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"v7baXHn7oK"}],"identifier":"compare-mesozooplankton-biomass-to-copepod-database","label":"Compare mesozooplankton biomass to COPEPOD database","html_id":"compare-mesozooplankton-biomass-to-copepod-database","implicit":true,"key":"oddJZ1UOJS"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We use data compiled through the COPEPOD project ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"CXN5bDd7Vw"},{"type":"cite","url":"https://doi.org/10.5194/essd-5-45-2013","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"(Moriarty & O’Brien, 2013)","position":{"start":{