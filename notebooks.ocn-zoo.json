110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\nax = fig.add_subplot(1,2,2, projection=ccrs.Robinson(central_longitude=305.0))\nax.set_title('CESM ${\\it Mesozooplankton}$ biomass', fontsize=12)\nlon, lat, field = adjust_pop_grid(lons, lats, ds_annual.mesozooC.mean(dim='z_t_150m'))\npc=ax.pcolormesh(lon, lat, field, cmap='Reds',vmin=0,vmax=2,transform=ccrs.PlateCarree())\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\n\nfig.subplots_adjust(right=0.8)\ncbar_ax = fig.add_axes([0.85, 0.15, 0.02, 0.7])\nfig.colorbar(pc, cax=cbar_ax,extend='max', label='top 150m/200m mean (mmol m$^{-3}$)');","key":"yFjxRpk2Cz"},{"type":"output","id":"vdQ4ZzBU62DOtnAc4PBe4","data":[],"key":"Jb80wxCs0g"}],"key":"V1Ed4ey7Fn"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Making monthly climatology maps to compare to observations","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"D7cYel65Oo"}],"identifier":"making-monthly-climatology-maps-to-compare-to-observations","label":"Making monthly climatology maps to compare to observations","html_id":"making-monthly-climatology-maps-to-compare-to-observations","implicit":true,"key":"UJAQ3HsQzO"}],"key":"WsbeTmSePI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare to observation-based GLMM (Generalized Linear Mixed Model) of global mesozooplankton biomass climatology","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SIRvoXzp9L"}],"identifier":"compare-to-observation-based-glmm-generalized-linear-mixed-model-of-global-mesozooplankton-biomass-climatology","label":"Compare to observation-based GLMM (Generalized Linear Mixed Model) of global mesozooplankton biomass climatology","html_id":"compare-to-observation-based-glmm-generalized-linear-mixed-model-of-global-mesozooplankton-biomass-climatology","implicit":true,"key":"IXsnPl5PuA"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"This data is from ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"jmuGW1JfU3"},{"type":"cite","url":"https://doi.org/10.1016/j.ecolmodel.2020.109265","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Heneghan et al., 2020","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"zoRooaFeY7"}],"kind":"narrative","label":"Heneghan_2020","identifier":"https://doi.org/10.1016/j.ecolmodel.2020.109265","enumerator":"2","key":"YBzTGjywab"},{"type":"text","value":", which includes the COPEPOD dataset we used previously as well as additional observations, with some pre-processing.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"aQpSVf3clE"}],"key":"YzFXUInSIB"}],"key":"OwzplidGvo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mesozoo_obs_path = 'data/obsglmm_zmeso_vint_200m_monthly_climatology.nc'\n\nds_copepod_clim = xr.open_dataset(mesozoo_obs_path)\nds_copepod_clim.zmeso200.attrs['units'] = 'mgC m-2'\n\nmonths = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']","key":"FUiaZhiRAG"},{"type":"output","id":"HkhOvVLTxz7EiSDYLldpt","data":[],"key":"ZxkkvEWnnw"}],"key":"HzgHe7gcFa"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Make our CESM data into a monthly climatology","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Xl5gNxb1lc"}],"identifier":"make-our-cesm-data-into-a-monthly-climatology","label":"Make our CESM data into a monthly climatology","html_id":"make-our-cesm-data-into-a-monthly-climatology","implicit":true,"key":"s2IKqpb5mr"}],"key":"v4Mt3L0xI2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mon_ds = ds.copy()\nmon_ds = ds.groupby('time.month').mean('time')","key":"ZqSLmsvWnJ"},{"type":"output","id":"xIYNg4bQyuv4tNtJ9dQxw","data":[],"key":"Vj5SEv8fUY"}],"key":"sldnnHRqtU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"### depth integrate and convert model to mg C/m2\nmon_ds['mesozooC_zint'] = ((mon_ds.mesozooC) * 10.).sum(dim='z_t_150m') #in mmol/m2\nmon_ds['mesozooC_zint'] = mon_ds['mesozooC_zint'] * 12.011 #convert to mgC/m2\nmon_ds['mesozooC_zint'].attrs['units'] = 'mgC m-2'","key":"CnaBntRt4n"},{"type":"output","id":"ZMWTlu0heAtHcNmwX3tKW","data":[],"key":"InRd5rM7Fy"}],"key":"nGmfViDh3S"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jsKbJ0PJ30"}],"identifier":"plot","label":"Plot","html_id":"plot-1","implicit":true,"key":"CuONodHzgk"}],"key":"yuim64lRNv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(5,18))\n\nfor row in np.arange(1,13):\n    \n    ts=row-1\n    \n    plot = row*2 - 1\n    ax = fig.add_subplot(12,2,plot, projection=ccrs.Robinson(central_longitude=305.0))\n    ax.set_title(months[ts]+' obs', fontsize=12)\n    pc=ax.pcolormesh(ds_copepod_clim.Lon, ds_copepod_clim.Lat, ds_copepod_clim.zmeso200.isel(month=ts), \n                     cmap='Reds',vmin=0,vmax=4000,transform=ccrs.PlateCarree())\n    land = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\n    ax.add_feature(land)\n    \n    plot = row*2\n    ax = fig.add_subplot(12,2,plot, projection=ccrs.Robinson(central_longitude=305.0))\n    ax.set_title(months[ts]+' CESM', fontsize=12)\n    tmp = mon_ds.mesozooC_zint.isel(month=ts)\n    lon, lat, field = adjust_pop_grid(lons, lats,  tmp)\n    pc=ax.pcolormesh(lon, lat, field, cmap='Reds',vmin=0,vmax=4000,transform=ccrs.PlateCarree())\n    land = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\n    ax.add_feature(land)\n\ncbar_ax = fig.add_axes([0.92, 0.15, 0.03, 0.7])\nfig.colorbar(pc, cax=cbar_ax,extend='max', label='Depth-integrated copepod biomass (mg m$^{-2}$)');","key":"w8dMcmxnla"},{"type":"output","id":"eUC9jk1yVsTcnR0YOrdHc","data":[],"key":"TZlU0ouNbp"}],"key":"lRm5mExH7W"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"And close the Dask cluster we spun up at the beginning.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"e3MWAgbDEz"}],"key":"s0snDUDoxt"}],"key":"mVzcHWcuWo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"cluster.close()","key":"Z3uEFwzDSI"},{"type":"output","id":"QkLiX_NVZ0zv05GmxEJ84","data":[],"key":"oHpGXJwIJU"}],"key":"DqKm9kv4JH"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lMn5KvE7W1"}],"key":"TExxkGVNa1"},{"type":"block","kind":"notebook-content","data":{"jp-MarkdownHeadingCollapsed":true},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position"