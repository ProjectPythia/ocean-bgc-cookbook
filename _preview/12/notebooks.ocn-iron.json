"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"jetstream_url = 'https://js2.jetstream-cloud.org:8001/'\n\ns3 = s3fs.S3FileSystem(anon=True, client_kwargs=dict(endpoint_url=jetstream_url))\n\n# Generate a list of all files in CESM folder\ns3path = 's3://pythia/ocean-bgc/cesm/g.e22.GOMIPECOIAF_JRA-1p4-2018.TL319_g17.4p2z.002branch/ocn/proc/tseries/month_1/*'\nremote_files = s3.glob(s3path)\n\n# Open all files from folder\nfileset = [s3.open(file) for file in remote_files]\n\n# Open with xarray\nds = xr.open_mfdataset(fileset, data_vars=\"minimal\", coords='minimal', compat=\"override\", parallel=True,\n                       drop_variables=[\"transport_components\", \"transport_regions\", 'moc_components'], decode_times=True)\n\nds","key":"jRMRJ4bBOk"},{"type":"output","id":"sHHGON_Ryq-SHKUWUibkx","data":[],"key":"xdqgcCsllS"}],"key":"bmvQqoUbaC"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Subsetting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QYN8iCph0s"}],"identifier":"subsetting","label":"Subsetting","html_id":"subsetting","implicit":true,"key":"KqKuFuTuH9"}],"key":"ZnRIyopUdl"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"variables =['Fe']","key":"xhs8SbiJvu"},{"type":"output","id":"By09wMWmAzMJv6MgD1HbA","data":[],"key":"xtgf58Zoot"}],"key":"iMHZaXoMK6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"keep_vars=['z_t','z_t_150m','dz','time_bound', 'time','TAREA','TLAT','TLONG'] + variables\nds = ds.drop_vars([v for v in ds.variables if v not in keep_vars])","key":"p84yXcFLyj"},{"type":"output","id":"T-n6bYC5NKAnPPRxdn3da","data":[],"key":"ZCbNfxV2PN"}],"key":"MTB4QscYrL"},{"type":"block","kind":"notebook-code"