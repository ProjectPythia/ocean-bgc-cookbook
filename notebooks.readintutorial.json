ook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import xarray as xr\nimport glob\nimport s3fs","key":"UJ58tIOF3A"},{"type":"outputs","id":"zd7uoYHK9ZfugNgbaHP5b","children":[],"key":"yZ0gUvs2y6"}],"key":"Bwmx6pWXkE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Loading our data into xarray","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lC1ti82jtQ"}],"identifier":"loading-our-data-into-xarray","label":"Loading our data into xarray","html_id":"loading-our-data-into-xarray","implicit":true,"key":"Cn720W66NZ"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Our data is stored in the cloud on Jetstream2. We load in each file path, then use xarray’s ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"iRACWdQvF3"},{"type":"inlineCode","value":"open_mfdataset()","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"b4EGBYrLFt"},{"type":"text","value":" function to load all the files into an xarray Dataset, dropping a few variables whose coordinates don’t fit nicely.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"kqxGN88r23"}],"key":"uvGxUIRu4s"}],"key":"joNNyNlNN1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"jetstream_url = 'https://js2.jetstream-cloud.org:8001/'\n\ns3 = s3fs.S3FileSystem(anon=True, client_kwargs=dict(endpoint_url=jetstream_url))\n\n# Generate a list of all files in CESM folder\ns3path = 's3://pythia/ocean-bgc/cesm/g.e22.GOMIPECOIAF_JRA-1p4-2018.TL319_g17.4p2z.002branch/ocn/proc/tseries/month_1/*'\nremote_files = s3.glob(s3path)\ns3.invalidate_cache()\n\n# Open all files from folder\nfileset = [s3.open(file) for file in remote_files]\n\n# Open with xarray\nds = xr.open_mfdataset(fileset, data_vars=\"minimal\", coords='minimal', compat=\"override\", parallel=True,\n                       drop_variables=[\"transport_components\", \"transport_regions\", 'moc_components'], decode_times=True)\n","key":"FkOuo5IOMk"},{"type":"outputs","id":"FNhIcj1QrxYr_6xjtiyQu","children":[],"key":"CiUXstwdJh"}],"key":"kbLWf30W2Y"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds","key":"HhibUwTqag"},{"type":"outputs","id":"QV0948NPePmNS5dv7L_m4","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":3,"metadata":{},"data":{"text/plain":{"content":"<xarray.Dataset> Size: 28GB\nDimensions:                         (time: 120, nlat: 384, nlon: 320, z_t: 60,\n                                     z_t_150m: 15)\nCoordinates:\n  * time                            (time) object 960B 2010-01-16 12:00:00 .....\n    TLAT                            (nlat, nlon) float64 983kB dask.array<chunksize=(384, 320), meta=np.ndarray>\n    TLONG                           (nlat, nlon) float64 983kB dask.array<chunksize=(384, 320), meta=np.ndarray>\n  * z_t                             (z_t) float32 240B 500.0 ... 5.375e+05\n  * z_t_150m                        (z_t_150m) float32 60B 500.0 ... 1.45e+04\nDimensions without coordinates: nlat, nlon\nData variables: (12/45)\n    FG_CO2                          (time, nlat, nlon) float32 59MB dask.array<chunksize=(60, 192, 160), meta=np.ndarray>\n    Fe                              (time, z_t, nlat, nlon) float32 4GB dask.array<chunksize=(30, 15, 96, 80), meta=np.ndarray>\n    NO3                             (time, z_t, nlat, nlon) float32 4GB dask.array<chunksize=(30, 15, 96, 80), meta=np.ndarray>\n    PO4                             (time, z_t, nlat, nlon) float32 4GB dask.array<chunksize=(30, 15, 96, 80), meta=np.ndarray>\n    POC_FLUX_100m                   (time, nlat, nlon) float32 59MB dask.array<chunksize=(60, 192, 160), meta=np.ndarray>\n    SALT                            (time, z_t, nlat, nlon) float32 4GB dask.array<chunksize=(30, 15, 96, 80), meta=np.ndarray>\n    ...                              ...\n    sp_Fe_lim_Cweight_avg_100m      (time, nlat, nlon) float32 59MB dask.array<chunksize=(60, 192, 160), meta=np.ndarray>\n    sp_Fe_lim_surf                  (time, nlat, nlon) float32 59MB dask.array<chunksize=(60, 192, 160), meta=np.ndarray>\n    sp_N_lim_Cweight_avg_100m       (time, nlat, nlon) float32 59MB dask.array<chunksize=(60, 192, 160), meta=np.ndarray>\n    sp_N_lim_surf                   (time, nlat, nlon) float32 59MB dask.array<chunksize=(60, 192, 160), meta=np.ndarray>\n    sp_P_lim_Cweight_avg_100m       (time, nlat, nlon) float32 59MB dask.array<chunksize=(60, 192, 160), meta=np.ndarray>\n    sp_P_lim_surf                   (time, nlat, nlon) float32 59MB dask.array<chunksize=(60, 192, 160), meta=np.ndarray>","content_type":"text/plain"},"text/html":{"content_type":"text/html","hash":"23f091f66ac807ad7a98d0b0e1bf3b74","path":"/ocean-bgc-cookbook/build/23f091f66ac807ad7a98d0b0e1bf3b74.html"}}},"key":"VYsRmOnwrC"}],"key":"jpuRVWVpnA"}],"key":"OnmDzVi3xL"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Looks good!","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"aAeskN8eGy"}],"key":"Q72j3ih27y"}],"key":"UEx8OcZQYT"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"B7q9ummjYo"}],"key":"HkxM1DSYaX"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,