\", parallel=True,\n                       drop_variables=[\"transport_components\", \"transport_regions\", 'moc_components'], decode_times=True)\n\nds","key":"vEhgeEIPE7"},{"type":"output","id":"Do2DXSKVMlD-QiW7yxy5W","data":[],"key":"v31f9s3xqS"}],"key":"r8hZtjxWNf"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Subsetting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"j9DrX30WFE"}],"identifier":"subsetting","label":"Subsetting","html_id":"subsetting","implicit":true,"key":"yf1kDP63lV"}],"key":"nyCBl2Mhko"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"variables =['Fe']","key":"PYm6Pj62o1"},{"type":"output","id":"pEP50olYfO9RZ0HDLR0Qr","data":[],"key":"M002xBJEXM"}],"key":"iL5gjYZ5vW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"keep_vars=['z_t','z_t_150m','dz','time_bound', 'time','TAREA','TLAT','TLONG'] + variables\nds = ds.drop_vars([v for v in ds.variables if v not in keep_vars])","key":"gKrU4Pks9G"},{"type":"output","id":"fGQMso7zh3UnzZhsAoSIf","data":[],"key":"I5w11GgE1E"}],"key":"GpUpS8Hwj9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds.Fe.isel(time=0,z_t=0).plot()","key":"jQLrfj8s3F"},{"type":"output","id":"nJqTpeC5JTbG727U8FEsP","data":[],"key":"u2wDxasnSZ"}],"key":"fsqa52TG6D"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Processing - long-term mean","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HIm3o4P064"}],"identifier":"processing-long-term-mean","label":"Processing - long-term mean","html_id":"processing-long-term-mean","implicit":true,"key":"XRuRIXcNBz"}],"key":"aGBJcO1GrI"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pull in the function we defined in the nutrients notebook...","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Rpo1wvSowq"}],"key":"PSAc8nOuIC"}],"key":"OqM09ojLoI"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Properly convert monthly data to annual means, taking into account month lengths.\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the year for each season is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")\n    ","key":"QFz3fHYWP2"},{"type":"output","id":"0v9BKouOEBAU89GlB0Bx8","data":[],"key":"mPq5ptuStY"}],"key":"WWhjLTfvOX"},{"type":"block","kind":"notebook-content","data":{"jp-MarkdownHeadingCollapsed":true},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Take the long-term mean of our data set. We process monthly to annual data with our custom function, then use xarray’s built-in ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iO8Okw7GjN"},{"type":"inlineCode","value":".mean()","position":{"start":{"line":1,"column":1},"