t","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Subsetting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iYd2jC6gtm"}],"identifier":"subsetting","label":"Subsetting","html_id":"subsetting","implicit":true,"key":"BUUodglMHn"}],"key":"OQJb4KKamG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"variables =['Fe']","key":"ap4WsTWbNG"},{"type":"outputs","id":"1Mv3r497WROq4g__IMARU","children":[],"key":"BHLxkgzwrD"}],"key":"lRN04XvAC1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"keep_vars=['z_t','z_t_150m','dz','time_bound', 'time','TAREA','TLAT','TLONG'] + variables\nds = ds.drop_vars([v for v in ds.variables if v not in keep_vars])","key":"yW4cSE9muF"},{"type":"outputs","id":"bKTs9rEMzUqETX63GmF34","children":[],"key":"NyLz1GCdLC"}],"key":"kw2Kjzis4n"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds.Fe.isel(time=0,z_t=0).plot()","key":"VcdEjIr4uE"},{"type":"outputs","id":"qoa_gzldT2L9f08uxzM_5","children":[],"key":"oxUjRkR70o"}],"key":"QujJraaIZK"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Processing - long-term mean","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"k1TzIN4FdP"}],"identifier":"processing-long-term-mean","label":"Processing - long-term mean","html_id":"processing-long-term-mean","implicit":true,"key":"naL6VNYse6"}],"key":"JrUXEwl9nm"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pull in the function we defined in the nutrients notebook...","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XLngOrW17K"}],"key":"ISBWPht2M6"}],"key":"WOavBZF0r0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Properly convert monthly data to annual means, taking into account month lengths.\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the year for each season is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")\n    ","key":"kw6d7qreB5"},{"type":"outputs","id":"leLLuKU7zL6C0uFDrsHHU","children":[],"key":"P8QsLsMzIh"}],"key":"XEvNbkVAZq"},{"type":"block","kind":"notebook-content","data":{"jp-MarkdownHeadingCollapsed":true},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Take the long-term mean of our data set. We process monthly to annual data with our custom function, then use xarray’s built-in ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bf8vGd2VGN"},{"type":"inlineCode","value":".mean()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"aDO8k1HAdr"},{"type":"text","value":" function to process from annual data to a single mean over time, since each year is the same length.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Mdu4I9qdU7"}],"key":"RrKkJDiKMg"}],"key":"cGTje1QNtn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds = year_mean(ds).mean(\"year\")","key":"GQNRsCZIvR"},{"type":"outputs","id":"mRHtRst3XSrAiEd0fmGur","children":[],"key":"y53ZdGTRCF"}],"key":"tjGidNzUQ5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"nmolcm3_to_nM = 1.e3\nds['Fe'] = ds['Fe'] * nmolcm3_to_nM\nds['Fe'].attrs['units'] = 'nM'","key":"phpVH30fcH"},{"type":"outputs","id":"pr3M_1ObYBAzQdGFrOWd6","children":[],"key":"rLI6jUE8wm"}],"key":"qXAIsDVlkv"},{"type":"block","kind":"notebook-content","data":{"editable":true,"slideshow":{"slide_type":""},"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare to observational Fe database","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"a2h91h505Q"}],"identifier":"compare-to-observational-fe-database","label":"Compare to observational Fe database","html_id":"compare-to-observational-fe-database","implicit":true,"key":"J02lKww5F8"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This dataset includes observations from the following papers:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XCXehDDE21"}],"key":"NdXyNiTN1t"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":4,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"cite","url":"https://doi.org/10.1016/j.chemgeo.2018.05.040","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Schlitzer et al., 2018","position":{"start":{"line":4,"column":1},"end