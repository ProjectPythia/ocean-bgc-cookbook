children":[{"type":"code","lang":"python","executable":true,"value":"keep_vars=['z_t','z_t_150m','dz','time_bound', 'time','TAREA','TLAT','TLONG'] + variables\nds = ds.drop_vars([v for v in ds.variables if v not in keep_vars])","key":"pZn8qQePDF"},{"type":"outputs","id":"_K4dNtpSQ4xTO0BcgKkVp","children":[],"key":"l4ym7yKUOi"}],"identifier":"a63a74ea-ac56-4034-aeaa-f648909fe59a","html_id":"a63a74ea-ac56-4034-aeaa-f648909fe59a","key":"aq8zsRXnvb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds.Fe.isel(time=0,z_t=0).plot()","key":"mJwr8mI3tt"},{"type":"outputs","id":"_jmZ_yBFS7oB4bynDsJrk","children":[],"key":"mnvhSeikXB"}],"identifier":"4321e1ec-03e1-45d6-bb0b-16fdcaa17ca3","html_id":"4321e1ec-03e1-45d6-bb0b-16fdcaa17ca3","key":"TwnXLtCjej"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Processing - long-term mean","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bG1t3r4Blh"}],"identifier":"processing-long-term-mean","label":"Processing - long-term mean","html_id":"processing-long-term-mean","implicit":true,"key":"aBwIs1YiuU"}],"identifier":"5e3e1e23-3443-419f-b724-2f0ef79a9087","html_id":"5e3e1e23-3443-419f-b724-2f0ef79a9087","key":"tzxlyPLfgR"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pull in the function we defined in the nutrients notebook...","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"chbDwG1q87"}],"key":"Ar5mpZlv4T"}],"identifier":"b461afc6-6894-4c53-8eae-a866ba3d8924","html_id":"b461afc6-6894-4c53-8eae-a866ba3d8924","key":"dyAz8Fzq9z"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Properly convert monthly data to annual means, taking into account month lengths.\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the year for each season is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")\n    ","key":"fgwHCYLOr5"},{"type":"outputs","id":"wAVk2Ap19C5rogdxncFQJ","children":[],"key":"XmfKinzfSU"}],"identifier":"7095de43-f488-4629-8da2-e15abce961a0","html_id":"7095de43-f488-4629-8da2-e15abce961a0","key":"Z0kadcQgx9"},{"type":"block","kind":"notebook-content","data":{"jp-MarkdownHeadingCollapsed":true},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Take the long-term mean of our data set. We process monthly to annual data with our custom function, then use xarray’s built-in ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"uaWLCRMq8a"},{"type":"inlineCode","value":".mean()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wdrv26nU8R"},{"type":"text","value":" function to process from annual data to a single mean over time, since each year is the same length.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bDTe1kgvo8"}],"key":"ulX7UzbQPs"}],"identifier":"089cc262-253d-44f2-a71c-96c4a8ff0954","html_id":"089cc262-253d-44f2-a71c-96c4a8ff0954","key":"RFAL22m7t4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds = year_mean(ds).mean(\"year\")","key":"vRrtbU08ah"},{"type":"outputs","id":"eIekILIPwrLC3NXJF-8bC","children":[],"key":"lVZQKfTwOU"}],"identifier":"54a768da-510b-4591-a20a-d8524ec5e97c","html_id":"54a768da-510b-4591-a20a-d8524ec5e97c","key":"dce8OtpTdP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"nmolcm3_to_nM = 1.e3\nds['Fe'] = ds['Fe'] * nmolcm3_to_nM\nds['Fe'].attrs['units'] = 'nM'","key":"kXUIx0MwuL"},{"type":"outputs","id":"SQgtlAl-1eUpAn0e17iZm","children":[],"key":"PG5f7r33kJ"}],"identifier":"044ce3e1-394d-471a-a8e6-5e99ce72f087","html_id":"044ce3e1-394d-471a-a8e6-5e99ce72f087","key":"t2acXiYrsV"},{"type":"block","kind":"notebook-content","data":{"editable":true,"slideshow":{"slide_type":""},"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare to observational Fe database","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bV5RauV0NR"}],"identifier":"compare-to-observational-fe-database","label":"Compare to observational Fe database","html_id":"compare-to-observational-fe-database","implicit":true,"key":"hrzLktBEAS"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This dataset includes observations from the following papers:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OtT6j7fZEC"}],"key":"n7tIgV5skn"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":4,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"cite","url":"https://doi.org/10.1016/j.chemgeo.2018.05.040","position":{"start":{"line":4,"column":1