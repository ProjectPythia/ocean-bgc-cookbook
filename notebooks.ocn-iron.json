ildren":[{"type":"code","lang":"python","executable":true,"value":"keep_vars=['z_t','z_t_150m','dz','time_bound', 'time','TAREA','TLAT','TLONG'] + variables\nds = ds.drop_vars([v for v in ds.variables if v not in keep_vars])","key":"HHhSXgJD9m"},{"type":"outputs","id":"7upDJ9Q1Qy9Ra66jP3fCq","children":[],"key":"oy2PAS7KBG"}],"identifier":"a63a74ea-ac56-4034-aeaa-f648909fe59a","html_id":"a63a74ea-ac56-4034-aeaa-f648909fe59a","key":"wNmRx4UoBU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds.Fe.isel(time=0,z_t=0).plot()","key":"dRj6G4jQNR"},{"type":"outputs","id":"9-02GQU9ccE_9CigiqLSe","children":[],"key":"L5glkjeic9"}],"identifier":"4321e1ec-03e1-45d6-bb0b-16fdcaa17ca3","html_id":"4321e1ec-03e1-45d6-bb0b-16fdcaa17ca3","key":"jjlLDIuf0V"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Processing - long-term mean","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QBJFWzcRKI"}],"identifier":"processing-long-term-mean","label":"Processing - long-term mean","html_id":"processing-long-term-mean","implicit":true,"key":"IVAR2gnMXm"}],"identifier":"5e3e1e23-3443-419f-b724-2f0ef79a9087","html_id":"5e3e1e23-3443-419f-b724-2f0ef79a9087","key":"ZOsDMUct9v"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pull in the function we defined in the nutrients notebook...","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"C6HiGCdot5"}],"key":"XPAWlcGHJj"}],"identifier":"b461afc6-6894-4c53-8eae-a866ba3d8924","html_id":"b461afc6-6894-4c53-8eae-a866ba3d8924","key":"IMHOHYM6NJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Properly convert monthly data to annual means, taking into account month lengths.\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the year for each season is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")\n    ","key":"QzEnYnPowr"},{"type":"outputs","id":"ntWw7d7XNbgugOh0mSTxg","children":[],"key":"yoYTbdK51S"}],"identifier":"7095de43-f488-4629-8da2-e15abce961a0","html_id":"7095de43-f488-4629-8da2-e15abce961a0","key":"JkR1Oai1Q9"},{"type":"block","kind":"notebook-content","data":{"jp-MarkdownHeadingCollapsed":true},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Take the long-term mean of our data set. We process monthly to annual data with our custom function, then use xarray’s built-in ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Pe1FMA4PdG"},{"type":"inlineCode","value":".mean()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"leZCxAZcho"},{"type":"text","value":" function to process from annual data to a single mean over time, since each year is the same length.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"syXF14FcZu"}],"key":"yhN60n4uUC"}],"identifier":"089cc262-253d-44f2-a71c-96c4a8ff0954","html_id":"089cc262-253d-44f2-a71c-96c4a8ff0954","key":"f9Krm5tmg9"},{"type":"block","kind":"notebook-code","children