ldren":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Properly convert monthly data to annual means, taking into account month lengths.\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the year for each season is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")\n    ","key":"PxESfW2zqz"},{"type":"outputs","id":"BzsMlZJ-eMJvlWHxJx90c","children":[],"key":"WfWeEiteqD"}],"key":"aRq136Gg0C"},{"type":"block","kind":"notebook-content","data":{"jp-MarkdownHeadingCollapsed":true},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Take the long-term mean of our data set. We process monthly to annual data with our custom function, then use xarray’s built-in ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"at5BNpHwld"},{"type":"inlineCode","value":".mean()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"r5Xb7Uq9FM"},{"type":"text","value":" function to process from annual data to a single mean over time, since each year is the same length.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jkZZljMDCw"}],"key":"kYvOSr2XwM"}],"key":"DN9iTKydNu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds = year_mean(ds).mean(\"year\")","key":"CXKAMIOTUT"},{"typ