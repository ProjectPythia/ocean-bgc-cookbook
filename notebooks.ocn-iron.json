otebook...","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LOK4LMjJWp"}],"key":"G2nDwGHFdw"}],"key":"qHREbQeiTs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Properly convert monthly data to annual means, taking into account month lengths.\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the year for each season is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")\n    ","key":"AOe49LD7K5"},{"type":"outputs","id":"zNr3tZ5jjYK3YoS_u7dH7","children":[],"key":"YpcGfhCugk"}],"key":"PQKu9OjMKk"},{"type":"block","kind":"notebook-content","data":{"jp-MarkdownHeadingCollapsed":true},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Take the long-term mean of our data set. We process monthly to annual data with our custom function, then use xarray’s built-in ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"E3PpWITg5A"},{"type":"inlineCode","value":".mean()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qJIvXcVQCm"},{"type":"text","value":" function to process from annual data to a single mean over time, since each year is the same length.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ewlvlXMSsp"}],"key":"xRnvCbfSJG"}],"key":"f75RvFuGLa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds = year_mean(ds).mean(\"year\")","key":"eastmFf2cp"},{"type":"outputs","id":"sPPPCz6bqWp8gRBGX7gNO","children":[],"key":"UvfPzwbpwZ"}],"key":"UI3LkDC6Kh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"nmolcm3_to_nM = 1.e3\nds['Fe'] = ds['Fe'] * nmolcm3_to_nM\nds['Fe'].attrs['units'] = 'nM'","key":"kXKWepQKQK"},{"type":"outputs","id":"hlN635Mf2mZZ-Hjqsu__W","children":[],"key":"UXscusWhhK"}],"key":"ZddlJzi6O3"},{"type":"block","kind":"notebook-content","data":{"editable":true,"slideshow":{"slide_type":""},"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare to observational Fe database","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KMb8AWMEUL"}],"identifier":"compare-to-observational-fe-database","label":"Compare to observational Fe database","html_id":"compare-to-observational-fe-database","implicit":true,"key":"D14EXSv8et"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This dataset includes observations from the following papers:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fv1hNVscut"}],"key":"LYxqpLUECP"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":4,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"cite","url":"https://doi.org/10.1016/j.chemgeo.2018.05.040","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Schlitzer et al., 2018","position":{"start":{"line":4,"column":1},"end