all files from folder\nfileset = [s3.open(file) for file in remote_files]\n\n# Open with xarray\nds = xr.open_mfdataset(fileset, data_vars=\"minimal\", coords='minimal', compat=\"override\", parallel=True,\n                       drop_variables=[\"transport_components\", \"transport_regions\", 'moc_components'], decode_times=True)\n\nds","key":"se1MpK5Spk"},{"type":"output","id":"qBy55kzvgjWp2nuEFPLs_","data":[],"key":"qaLMCpvJi7"}],"key":"zmi6cJYssU"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Subsetting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nAphBQIDyX"}],"identifier":"subsetting","label":"Subsetting","html_id":"subsetting","implicit":true,"key":"O72IBkbF6j"}],"key":"cyelxrZLuq"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"variables =['Fe']","key":"Euq2HreKdP"},{"type":"output","id":"6TMvkK9t2ChJvCs4rW03A","data":[],"key":"MULFGKdf4G"}],"key":"K2ws3wOk4T"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"keep_vars=['z_t','z_t_150m','dz','time_bound', 'time','TAREA','TLAT','TLONG'] + variables\nds = ds.drop_vars([v for v in ds.variables if v not in keep_vars])","key":"bkC9cRhpS5"},{"type":"output","id":"DFIBqIHNfi1CygvRglPES","data":[],"key":"fV1G57lIDo"}],"key":"joWpz9eQjE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds.Fe.isel(time=0,z_t=0).plot()","key":"yjGobx6FCZ"},{"type":"output","id":"Lc9pbvQY37WYBhjoz4dI_","data":[],"key":"x1zwNgxF5t"}],"key":"LkhhnN0f1u"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Processing - long-term mean","position":{"sta