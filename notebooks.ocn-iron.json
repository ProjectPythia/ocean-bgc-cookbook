\"override\", parallel=True,\n                       drop_variables=[\"transport_components\", \"transport_regions\", 'moc_components'], decode_times=True)\n\nds","key":"MbMkVZtTpS"},{"type":"output","id":"HPOK8uQYJSWdfaUA4i8Dg","data":[],"key":"C7XFiw6jFf"}],"key":"wU6lxZC4Bw"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Subsetting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"v6WQiQy4tG"}],"identifier":"subsetting","label":"Subsetting","html_id":"subsetting","implicit":true,"key":"TXzAMLBMIp"}],"key":"Gre87gddlC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"variables =['Fe']","key":"G71Bn5wBN1"},{"type":"output","id":"abOiC4z0UyOUip9aKsGXv","data":[],"key":"jFHkqd15wV"}],"key":"miogKQ2Yni"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"keep_vars=['z_t','z_t_150m','dz','time_bound', 'time','TAREA','TLAT','TLONG'] + variables\nds = ds.drop_vars([v for v in ds.variables if v not in keep_vars])","key":"FeLRPSxQtA"},{"type":"output","id":"h5KRCjIKFs-d3zWeo7A5P","data":[],"key":"v3ZpfkJ7hc"}],"key":"mniReVaDXr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds.Fe.isel(time=0,z_t=0).plot()","key":"crUkv0GPLT"},{"type":"output","id":"dvaAGNSKwi0WkBesC2diI","data":[],"key":"RIWvuIuUIh"}],"key":"EUNMHE7na3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Processing - long-term mean","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GzXOYYjLKc"}],"identifier":"processing-long-term-mean","label":"Processing - long-term mean","html_id":"processing-long-term-mean","implicit":true,"key":"Bm7s5H4NeN"}],"key":"VBWnTCBmBZ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pull in the function we defined in the nutrients notebook...","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Qksel8w8Q3"}],"key":"JRRDl5jVgR"}],"key":"OpLHGQbm4G"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Properly convert monthly data to annual means, taking into account month lengths.\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the year for each season is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")\n    ","key":"VYGpxpahky"},{"type":"output","id":"wfx_KDHq0duB5pez5JGPB","data":[],"key":"mERWLt7E95"}],"key":"VSuGFTcz6M"},{"type":"block","kind":"notebook-content","data":{"jp-MarkdownHeadingCollapsed":true},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Take the long-term mean of our data set. We process monthly to annual data with our custom function, then use xarray’s built-in ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cIv9fe7e8I"},{"type":"inlineCode","value":".mean()","position":{"start":{"line":1,"co