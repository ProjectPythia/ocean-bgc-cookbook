jlcDXGqqC"}],"identifier":"subsetting","label":"Subsetting","html_id":"subsetting","implicit":true,"key":"lCQzVCTR71"}],"key":"F14dTqgT1f"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"variables =['Fe']","key":"ph9ffJLAvG"},{"type":"outputs","id":"8eYWS1DhiIxUHzEzE4i6T","children":[],"key":"ddQ2hw1rKi"}],"key":"PopKuNFv8u"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"keep_vars=['z_t','z_t_150m','dz','time_bound', 'time','TAREA','TLAT','TLONG'] + variables\nds = ds.drop_vars([v for v in ds.variables if v not in keep_vars])","key":"P5GMwL7GxD"},{"type":"outputs","id":"mxQaOL3ocLpoH_S7cURbZ","children":[],"key":"Hrltj0apnF"}],"key":"ZCDEpFYHkM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds.Fe.isel(time=0,z_t=0).plot()","key":"lDvw7CYP7d"},{"type":"outputs","id":"TKamrCnCSmcXGmalN8rEK","children":[],"key":"dV0ti9S2Hq"}],"key":"QODN4BudEX"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Processing - long-term mean","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"A5PC80Ie7W"}],"identifier":"processing-long-term-mean","label":"Processing - long-term mean","html_id":"processing-long-term-mean","implicit":true,"key":"SBlTaqlFOq"}],"key":"fsq7mvi9qW"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pull in the function we defined in the nutrients notebook...","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"k1PoYDfqHn"}],"key":"U0DIcGgZf3"}],"key":"LbnYBTG0Oe"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Properly convert monthly data to annual means, taking into account month lengths.\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the year for each season is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")\n    ","key":"HvRM1NffuE"},{"type":"outputs","id":"L_o5tCrymwvw93lAJQZri","children":[],"key":"mRFn4zouCH"}],"key":"cy5SBniXtM"},{"type":"block","kind":"notebook-content","data":{"jp-MarkdownHeadingCollapsed":true},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Take the long-term mean of our data set. We process monthly to annual data with our custom function, then use xarray’s built-in ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"aS9802QIbJ"},{"type":"inlineCode","value":".mean()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pLh37deV2E"},{"type":"text","value":" function to process from annual data to a single mean over time, since each year is the same length.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Gw9GtJkLpY"}],"key":"sM4qWiFd8B"}],"key":"hDpWjWTKhR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds = year_mean(ds).mean(\"year\")","key":"FUGFEeiQjR"},{"type":"outputs","id":"6b4w-vsZWa8zoWaAQ2VLB","children":