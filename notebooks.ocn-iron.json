ue":"Long et al., 2021","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"c2l51QFvq6"}],"kind":"narrative","label":"Long_2021","identifier":"https://doi.org/10.1029/2021MS002647","enumerator":"4","key":"GTqP91l7dm"},{"type":"text","value":" -- see this paper for details.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"D5e21OJE8o"}],"key":"tXSsJAmGer"}],"identifier":"b741fef7-406c-4186-bf26-479c03ca8fae","html_id":"b741fef7-406c-4186-bf26-479c03ca8fae","visibility":"show","key":"ee1wdR3qQF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fe_obs_path = 's3://pythia/ocean-bgc/obs/dFe-database-2021-05-20.csv'\n\nfe_obs = s3.open(fe_obs_path)\n\ndf = pd.read_csv(fe_obs, na_values=-999.).dropna(axis=0, how='all')\n\ndf","key":"xHm2dG1fn0"},{"type":"outputs","id":"xiWepU8dEHuQpmpQcE9ho","children":[],"key":"xjxArYcsm1"}],"identifier":"f7d11915-3fe0-4037-8cba-cce3929cb7c9","html_id":"f7d11915-3fe0-4037-8cba-cce3929cb7c9","key":"mVPq2unzsg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(16,5))\n\nfig.suptitle(\"Surface iron concentration comparison\")\n\n### CESM\nax = fig.add_subplot(1,2,1, projection=ccrs.Robinson(central_longitude=305.0))\nlon, lat, field = adjust_pop_grid(lons, lats,  ds.Fe.isel(z_t=0))\npc=ax.pcolormesh(lon, lat, field, cmap='plasma',vmin=0,vmax=3,transform=ccrs.PlateCarree())\nland = cartopy.feature.NaturalEarthFeature('physical', 'land', scale='110m', edgecolor='k', facecolor='white', linewidth=0.5)\nax.add_feature(land)\nax.set_title('CESM Fe at surface', fontsize=10)\n\n\n### obs\nax = fig.add_subplot(1,2,2, projection=ccrs.Robinson(central_longitude=305.0))\nax.coastlines('10m',linewidth=0.5)\nax.set_title('Obs Fe at surface', fontsize=10)\n\n\ndf_sub = df.loc[(df.depth <= 2.5)]\nsc = ax.scatter(df_sub.lon, df_sub.lat, c=df_sub.dFe_obs.values,\n                cmap='plasma',\n                vmin=0, vmax=3, \n                transform=ccrs.PlateCarree())\n\nfig.subplots_adjust(right=0.8)\ncbar_ax = fig.add_axes([0.85, 0.15, 0.02, 0.7])\nfig.colorbar(pc, cax=cbar_ax, label='Fe (nM)')\n\n","key":"nqs5w3n5n0"},{"type":"outputs","id":"pt0T1nHqixD39G2erTs8H","children":[],"key":"fUDUdRwsW6"}],"identifier":"a7d1051a-c2be-4e42-835b-b3634e7bf10e","html_id":"a7d1051a-c2be-4e42-835b-b3634e7bf10e","key":"jmX2cImAD0"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"And close the Dask cluster we spun up at the beginning.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JRSuW9bymu"}],"key":"TElDd8UeJD"}],"identifier":"1f65ccd9-bc93-45a2-9097-d07ed8e26129","html_id":"1f65ccd9-bc93-45a2-9097-d07ed8e26129","key":"MSbTBzAN9m"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"cluster.close()","key":"m2Bavm5RHK"},{"type":"outputs","id":"awXvjPi9WZAO3pWDBaKFy","children":[],"key":"YL5suh8817"}],"identifier":"0ec300cf-d53a-4abf-a590-7b90b044fcc8","html_id":"0ec300cf-d53a-4abf-a590-7b90b044fcc8","key":"JQCyXaKejO"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"W5MejYf6Tp"}],"identifier":"547b0aa9-c4ad-4846-ade8-83d2f712b0a8","html_id":"547b0aa9-c4ad-4846-ade8-83d2f712b0a8","key":"Sg1VP8yiYy"},{"type":"block","kind":"notebook-content","data":{"jp-MarkdownHeadingCollapsed":true},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nMeLUs3AHr"}],"identifier":"summary","label":"Summary","html_id":"summary","implicit":true,"ke