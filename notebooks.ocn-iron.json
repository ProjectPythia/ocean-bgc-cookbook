all files from folder\nfileset = [s3.open(file) for file in remote_files]\n\n# Open with xarray\nds = xr.open_mfdataset(fileset, data_vars=\"minimal\", coords='minimal', compat=\"override\", parallel=True,\n                       drop_variables=[\"transport_components\", \"transport_regions\", 'moc_components'], decode_times=True)\n\nds","key":"gqxhb9NUTw"},{"type":"output","id":"RayJdd2zW2Iam7_c62PBR","data":[],"key":"xrkV6bjf26"}],"key":"rdlks2cH7Z"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Subsetting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CTWX7gzXeK"}],"identifier":"subsetting","label":"Subsetting","html_id":"subsetting","implicit":true,"key":"eUW4iaRA1w"}],"key":"IJTGcpwuHI"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"variables =['Fe']","key":"qgE8cBP5dW"},{"type":"output","id":"yE11zbmB9Est_ODEHrnIW","data":[],"key":"wVs56jhJ9R"}],"key":"sBLql1AEpk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"keep_vars=['z_t','z_t_150m','dz','time_bound', 'time','TAREA','TLAT','TLONG'] + variables\nds = ds.drop_vars([v for v in ds.variables if v not in keep_vars])","key":"EQJah5OZja"},{"type":"output","id":"CAFnidHVPs7emfmg4EgeA","data":[],"key":"Prz24RMWnT"}],"key":"WutgyR2ZT4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds.Fe.isel(time=0,z_t=0).plot()","key":"iwqcuRU3b0"},{"type":"output","id":"KuwyUFDMt1T3WPubRiQ59","data":[],"key":"hOb2DJ51nL"}],"key":"KpSmNjKTOR"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Processing - long-term mean","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ISsfsfiOUO"}],"identifier":"processing-long-term-mean","label":"Processing - long-term mean","html_id":"processing-long-term-mean","implicit":true,"key":"EhwUP0cQoF"}],"key":"odYGThjeBk"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pull in the function we defined in the nutrients notebook...","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UP9yUKteVh"}],"key":"fMNATcPNX3"}],"key":"h4G1z7rKFG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Properly convert monthly data to annual means, taking into account month lengths.\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the year for each season is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")\n    ","key":"B0YB3VODNV"},{"type":"output","id":"CUKBKO_NVj7yRdXGDD34G","data":[],"key":"ph5ZfzXNJ5"}],"key":"vCMzIbDEmk"},{"type":"block","kind":"notebook-content","data":{"jp-MarkdownHeadingCollapsed":true},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Take the long-term mean of our data set. We process monthly to annual data with our custom function, then use xarray