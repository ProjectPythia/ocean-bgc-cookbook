, c=df_sub.dFe_obs.values,\n                cmap='plasma',\n                vmin=0, vmax=3, \n                transform=ccrs.PlateCarree())\n\nfig.subplots_adjust(right=0.8)\ncbar_ax = fig.add_axes([0.85, 0.15, 0.02, 0.7])\nfig.colorbar(pc, cax=cbar_ax, label='Fe (nM)')\n\n","key":"il7RBlHfio"},{"type":"outputs","id":"viFZilapIuzDcSegKDo7P","children":[],"key":"xwdxzSOj4m"}],"identifier":"a7d1051a-c2be-4e42-835b-b3634e7bf10e","html_id":"a7d1051a-c2be-4e42-835b-b3634e7bf10e","key":"fXdkcmbKp2"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"And close the Dask cluster we spun up at the beginning.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EWNnSB1Gww"}],"key":"HW7Gih4dXh"}],"identifier":"1f65ccd9-bc93-45a2-9097-d07ed8e26129","html_id":"1f65ccd9-bc93-45a2-9097-d07ed8e26129","key":"Zc9MX3LVFb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"cluster.close()","key":"TgHoqDVRLP"},{"type":"outputs","id":"cvTSsf5FlHz2t4NnXOfte","children":[],"key":"Og96134Mgu"}],"identifier":"0ec300cf-d53a-4abf-a590-7b90b044fcc8","html_id":"0ec300cf-d53a-4abf-a590-7b90b044fcc8","key":"SIrGuhSj6L"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZULWEwf2k2"}],"identifier":"547b0aa9-c4ad-4846-ade8-83d2f712b0a8","html_id":"547b0aa9-c4ad-4846-ade8-83d2f712b0a8","key":"fgd6KiLQpx"},{"type":"block","kind":"notebook-content","data":{"jp-MarkdownHeadingCollapsed":true},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yZAhG8LAgu"}],"identifier":"summary","label":"Summary","html_id":"sum