all files from folder\nfileset = [s3.open(file) for file in remote_files]\n\n# Open with xarray\nds = xr.open_mfdataset(fileset, data_vars=\"minimal\", coords='minimal', compat=\"override\", parallel=True,\n                       drop_variables=[\"transport_components\", \"transport_regions\", 'moc_components'], decode_times=True)\n\nds","key":"ReUe3BhTbz"},{"type":"output","id":"oy1e3yY_cAcBtmSA_1-UO","data":[],"key":"UA4qMRv2Bu"}],"key":"e48YRD7jzg"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Subsetting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TZCZepKsra"}],"identifier":"subsetting","label":"Subsetting","html_id":"subsetting","implicit":true,"key":"y2mp5E5pa1"}],"key":"yK7Iyk9yDr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"variables =['Fe']","key":"uw9eKtNVdF"},{"type":"output","id":"GjRJmcdTRBTIXdkt3XZQa","data":[],"key":"FcMa4IZVRR"}],"key":"fj9sxReFM1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"keep_vars=['z_t','z_t_150m','dz','time_bound', 'time','TAREA','TLAT','TLONG'] + variables\nds = ds.drop_vars([v for v in ds.variables if v not in keep_vars])","key":"rZVcZ0Lg6A"},{"type":"output","id":"1N7NPoctNwzEugRm5RkSO","data":[],"key":"xWkRBTqqYZ"}],"key":"g4Mww3jDk2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds.Fe.isel(time=0,z_t=0).plot()","key":"XpgvyYbBdU"},{"type":"output","id":"K5WinYplhWHZxVRGBXFo_","data":[],"key":"qY3ilvTIoi"}],"key":"Wo9IwzHi5x"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Processing - long-term mean","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"H9g5jGqicf"}],"identifier":"processing-long-term-mean","label":"Processing - long-term mean","html_id":"processing-long-term-mean","implicit":true,"key":"gSDatZ6SUS"}],"key":"p7IydmPPut"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pull in the function we defined in the nutrients notebook...","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ToM22I4PWV"}],"key":"tnV2W1hJZu"}],"key":"BDyKu2THkD"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Properly convert monthly data to annual means, taking into account month lengths.\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the year for each season is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")\n    ","key":"ak0WmkYeg3"},{"type":"output","id":"zT6GeDiYiEz3ReWAckGgV","data":[],"key":"ikFztGeTv6"}],"key":"ew8UESilqd"},{"type":"block","kind":"notebook-content","data":{"jp-MarkdownHeadingCollapsed":true},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Take the long-term mean of our data set. We process monthly to annual data with our custom function, then use xarray