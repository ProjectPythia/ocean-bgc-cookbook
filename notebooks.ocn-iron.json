otebook...","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cW9yKB50Qb"}],"key":"SpvIsij7ec"}],"key":"y00fq2sApC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def year_mean(ds):\n    \"\"\"\n    Properly convert monthly data to annual means, taking into account month lengths.\n    Source: https://ncar.github.io/esds/posts/2021/yearly-averages-xarray/\n    \"\"\"\n    \n    # Make a DataArray with the number of days in each month, size = len(time)\n    month_length = ds.time.dt.days_in_month\n\n    # Calculate the weights by grouping by 'time.year'\n    weights = (\n        month_length.groupby(\"time.year\") / month_length.groupby(\"time.year\").sum()\n    )\n\n    # Test that the sum of the year for each season is 1.0\n    np.testing.assert_allclose(weights.groupby(\"time.year\").sum().values, np.ones((len(ds.groupby(\"time.year\")), )))\n\n    # Calculate the weighted average\n    return (ds * weights).groupby(\"time.year\").sum(dim=\"time\")\n    ","key":"fzNkhuoueQ"},{"type":"outputs","id":"bxVSLktWHCINFtbS7c4o2","children":[],"key":"EOfN2LBQAj"}],"key":"d2OFN5wWuj"},{"type":"block","kind":"notebook-content","data":{"jp-MarkdownHeadingCollapsed":true},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Take the long-term mean of our data set. We process monthly to annual data with our custom function, then use xarray’s built-in ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EhEk4LsUFG"},{"type":"inlineCode","value":".mean()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CMAuwDOy0u"},{"type":"text","value":" function to process from annual data to a single mean over time, since each year is the same length.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oqYshX4c4H"}],"key":"nOSgZf7JyT"}],"key":"lcsh6LI4Kt"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds = year_mean(ds).mean(\"year\")","key":"siQPDXMhgb"},{"type":"outputs","id":"HUjwu6uTRELX_W9EkCvUy","children":[],"key":"b9G1iaCaDU"}],"key":"baKZ5UdhIy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"nmolcm3_to_nM = 1.e3\nds['Fe'] = ds['Fe'] * nmolcm3_to_nM\nds['Fe'].attrs['units'] = 'nM'","key":"b7eZePVjbD"},{"type":"outputs","id":"0FP4P-nQKboN-6o3e2gon","children":[],"key":"WH5lEKDrAq"}],"key":"KvQzoWfk3X"},{"type":"block","kind":"notebook-content","data":{"editable":true,"slideshow":{"slide_type":""},"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare to observational Fe database","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BuSmnXQ6hY"}],"identifier":"compare-to-observational-fe-database","label":"Compare to observational Fe database","html_id":"compare-to-observational-fe-database","implicit":true,"key":"qmF1cOBwgF"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This dataset includes observations from the following papers:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"MkjAadhlrp"}],"key":"rRSlntsiOu"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":4,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"cite","url":"https://doi.org/10.1016/j.chemgeo.2018.05.040","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Schlitzer et al., 2018","position":{"start":{"line":4,"column":1},"end